#!/bin/bash
# Pre-push guard (P-82): installed by lane.sh setup (core.hooksPath=.githooks). Runs product/tools/push-guard.sh
# on every ref being pushed; a push containing an excluded path, a PDF, a secret or a personal name is refused,
# and so is any push to main (P-87; XR_ALLOW_MAIN_PUSH=1 only for an emergency the founder approves).
ROOT="$(git rev-parse --show-toplevel)"; GUARD="$ROOT/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/push-guard.sh"
[ -x "$GUARD" ] || { echo "push guard missing at $GUARD — push refused (restore it or run lane.sh setup)"; exit 1; }
rc=0
while read -r lref lsha rref rsha; do
  case "$lsha" in *[!0]*) ;; *) continue;; esac          # local delete: nothing to check
  # P-87: every change reaches main by PR (GitHub cannot lock main on this plan, so the rule is held here too).
  [ "$rref" = refs/heads/main ] && [ -z "$XR_ALLOW_MAIN_PUSH" ] && { echo "Push to main refused (P-87): push your branch and open a PR."; rc=1; continue; }
  if [ "$rsha" = "0000000000000000000000000000000000000000" ]; then
    "$GUARD" --unpushed "$lsha" || rc=1
  else
    "$GUARD" "$rsha..$lsha" || rc=1
  fi
done
exit $rc
