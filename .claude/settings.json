{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * --delete*)",
      "Bash(git push * :*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push -d*)",
      "Bash(git -C * push * -d*)",
      "Bash(git -C * push * --delete*)",
      "Bash(git -C * push * :*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue close*)",
      "Bash(gh repo create*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh secret*)",
      "Bash(gh variable set*)",
      "Bash(gh api -X POST*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api -X PATCH*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method*)",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__create_file",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__update_file",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__copy_file",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__trash_file",
      "mcp__550bd2b4-79d5-41e3-b030-655e745a3639__share_file"
    ],
    "allow": [
      "Bash(gh pr edit * --add-label \"review: approved\")",
      "Bash(gh pr edit * --remove-label \"review: approved\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/session-start.sh 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Loading Pathway Configurator state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/merge-guard.sh",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(gh pr close*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/merge-guard.sh",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(gh pr review*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/merge-guard.sh",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "(^|__)start_session$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/lane-preflight.sh --hook",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/stop-check.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/ai-workers/tools/prompt-log.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/Xpatready/code/**",
    "**/Xpatready/sources/**",
    "**/Xpatready/archive/**"
  ]
}
