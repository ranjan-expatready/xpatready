{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://expatready.local/contracts/combination-config.v0.json",
 "title": "One combination's configuration: the draft the AI writes and people review before release (implementation design \u00a73, item 1)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract_version",
  "combination",
  "configuration_version",
  "status",
  "label",
  "sources",
  "drafting_run_ids",
  "canonical_fields",
  "field_maps",
  "forms",
  "document_requirements",
  "rules",
  "sections",
  "placements",
  "checks",
  "structure",
  "unresolved",
  "derived_fields"
 ],
 "definitions": {
  "source": {
   "type": "object",
   "required": [
    "file",
    "sha256"
   ],
   "properties": {
    "file": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "cited": {
   "type": "object",
   "required": [
    "source_file",
    "source_quote"
   ],
   "properties": {
    "source_file": {
     "type": "string",
     "minLength": 1
    },
    "source_quote": {
     "type": "string",
     "minLength": 2
    }
   }
  }
 },
 "properties": {
  "contract_version": {
   "const": "combination-config/v0"
  },
  "combination": {
   "type": "string"
  },
  "configuration_version": {
   "type": "string"
  },
  "status": {
   "enum": [
    "draft",
    "released"
   ],
   "description": "a draft is never used operationally; release needs the D254 second-person rule (AIW-D263)"
  },
  "label": {
   "type": "string",
   "minLength": 10
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/definitions/source"
   }
  },
  "drafting_run_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "canonical_fields": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "meaning",
     "value_type",
     "proposed_by"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
     },
     "meaning": {
      "type": "string"
     },
     "value_type": {
      "type": "string"
     },
     "proposed_by": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     },
     "decide": {
      "type": "string"
     }
    }
   }
  },
  "field_maps": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "form_edition",
     "form_sha256",
     "drafting_run_id",
     "entries"
    ],
    "properties": {
     "form_edition": {
      "type": "string"
     },
     "form_sha256": {
      "type": "string"
     },
     "drafting_run_id": {
      "type": "string"
     },
     "entries": {
      "type": "array",
      "items": {
       "$ref": "https://expatready.local/contracts/field-map-entry.v0.json"
      }
     }
    }
   }
  },
  "forms": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "$ref": "#/definitions/cited"
     },
     {
      "type": "object",
      "required": [
       "form_number",
       "who",
       "status"
      ]
     }
    ]
   }
  },
  "document_requirements": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "$ref": "#/definitions/cited"
     },
     {
      "type": "object",
      "required": [
       "document_type",
       "who",
       "base_or_conditional",
       "status"
      ]
     }
    ]
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "$ref": "#/definitions/cited"
     },
     {
      "type": "object",
      "required": [
       "kind",
       "when",
       "then",
       "for_whom"
      ]
     }
    ]
   }
  },
  "sections": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "new"
    ]
   }
  },
  "placements": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "fact",
     "section_id",
     "collected_from",
     "tier"
    ]
   }
  },
  "checks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "group",
     "severity",
     "made_by"
    ],
    "properties": {
     "made_by": {
      "enum": [
       "ai_draft",
       "rule"
      ]
     },
     "severity": {
      "enum": [
       "block",
       "warn",
       "advise",
       "sme_pending"
      ]
     }
    }
   }
  },
  "structure": {
   "type": "object",
   "description": "structure checks run by the assembler (activity 4.1 style); a failing item is listed in unresolved, never hidden"
  },
  "unresolved": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "from",
     "item",
     "reason"
    ]
   }
  },
  "derived_fields": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "calculation",
     "inputs",
     "reference",
     "executable"
    ],
    "properties": {
     "executable": {
      "type": "boolean",
      "description": "true only when the calculation has a tested helper (AIW-D264)"
     }
    }
   }
  }
 }
}
