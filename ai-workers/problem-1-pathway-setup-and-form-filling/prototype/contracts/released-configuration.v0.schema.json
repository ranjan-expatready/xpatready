{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://expatready.local/contracts/released-configuration.v0.json",
 "title": "A released combination configuration: the reviewed draft with each item's version and decision (derived from combination-config.v0 by p4/make_release_contract.py)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract_version",
  "combination",
  "configuration_version",
  "status",
  "label",
  "sources",
  "drafting_run_ids",
  "canonical_fields",
  "field_maps",
  "forms",
  "document_requirements",
  "rules",
  "sections",
  "placements",
  "checks",
  "structure",
  "unresolved",
  "derived_fields",
  "review"
 ],
 "definitions": {
  "source": {
   "type": "object",
   "required": [
    "file",
    "sha256"
   ],
   "properties": {
    "file": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "cited": {
   "type": "object",
   "required": [
    "source_file",
    "source_quote"
   ],
   "properties": {
    "source_file": {
     "type": "string",
     "minLength": 1
    },
    "source_quote": {
     "type": "string",
     "minLength": 2
    }
   }
  },
  "released_entry": {
   "title": "One box on one form edition: which person's which fact goes there, and how",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "form_edition",
    "form_sha256",
    "data_path",
    "outcome",
    "item_version",
    "decision"
   ],
   "properties": {
    "form_edition": {
     "type": "string",
     "pattern": "^(IMM|IRM) [0-9A-Z ]+ \\([0-9]{2}-[0-9]{4}\\)$"
    },
    "form_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "data_path": {
     "type": "string",
     "minLength": 3,
     "description": "XFA data path, indices explicit, repeated rows as [n]"
    },
    "outcome": {
     "enum": [
      "mapped",
      "unresolved",
      "never_filled",
      "not_a_fact"
     ],
     "description": "not_a_fact: form mechanics, not a fact (W1 3.1 ready: an explicit 'not a fact' mark); added in P1 revision 4"
    },
    "confidence": {
     "enum": [
      "high",
      "medium",
      "low"
     ]
    },
    "person": {
     "type": "string",
     "description": "role relative to the form's subject: subject, spouse_or_partner, parent, child, or a case person id"
    },
    "fact": {
     "type": "string",
     "pattern": "^[a-z][a-z_]*\\.[a-z][a-z0-9_]*$",
     "maxLength": 80
    },
    "transform": {
     "type": "string",
     "description": "named transform, e.g. code_list:imm5707.marital_status, date_part:year"
    },
    "row": {
     "type": "integer",
     "minimum": 0
    },
    "condition": {
     "type": "string"
    },
    "unresolved_reason": {
     "type": "string"
    },
    "evidence": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "file_sha256",
      "quote"
     ],
     "properties": {
      "file_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "quote": {
       "type": "string",
       "minLength": 2
      }
     }
    },
    "item_version": {
     "type": "integer",
     "minimum": 1
    },
    "decision": {
     "enum": [
      "accepted",
      "corrected",
      "left_unresolved"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "outcome": {
        "const": "mapped"
       }
      }
     },
     "then": {
      "required": [
       "person",
       "fact",
       "evidence"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "outcome": {
        "enum": [
         "unresolved",
         "never_filled",
         "not_a_fact"
        ]
       }
      }
     },
     "then": {
      "required": [
       "unresolved_reason"
      ]
     }
    }
   ]
  }
 },
 "properties": {
  "contract_version": {
   "const": "combination-config/v0"
  },
  "combination": {
   "type": "string"
  },
  "configuration_version": {
   "type": "string"
  },
  "status": {
   "const": "released"
  },
  "label": {
   "type": "string",
   "minLength": 10
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/definitions/source"
   }
  },
  "drafting_run_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "canonical_fields": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "type": "object",
      "required": [
       "id",
       "meaning",
       "value_type",
       "proposed_by"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
       },
       "meaning": {
        "type": "string"
       },
       "value_type": {
        "type": "string"
       },
       "proposed_by": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string"
        }
       },
       "decide": {
        "type": "string"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "item_version"
      ],
      "properties": {
       "item_version": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    ]
   }
  },
  "field_maps": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "form_edition",
     "form_sha256",
     "drafting_run_id",
     "entries"
    ],
    "properties": {
     "form_edition": {
      "type": "string"
     },
     "form_sha256": {
      "type": "string"
     },
     "drafting_run_id": {
      "type": "string"
     },
     "entries": {
      "type": "array",
      "items": {
       "$ref": "#/definitions/released_entry"
      }
     }
    }
   }
  },
  "forms": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "$ref": "#/definitions/cited"
     },
     {
      "type": "object",
      "required": [
       "form_number",
       "who",
       "status"
      ]
     },
     {
      "type": "object",
      "required": [
       "item_version"
      ],
      "properties": {
       "item_version": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    ]
   }
  },
  "document_requirements": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "$ref": "#/definitions/cited"
     },
     {
      "type": "object",
      "required": [
       "document_type",
       "who",
       "base_or_conditional",
       "status"
      ]
     },
     {
      "type": "object",
      "required": [
       "item_version"
      ],
      "properties": {
       "item_version": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    ]
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "$ref": "#/definitions/cited"
     },
     {
      "type": "object",
      "required": [
       "kind",
       "when",
       "then",
       "for_whom"
      ]
     },
     {
      "type": "object",
      "required": [
       "item_version"
      ],
      "properties": {
       "item_version": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    ]
   }
  },
  "sections": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "type": "object",
      "required": [
       "id",
       "title",
       "new"
      ]
     },
     {
      "type": "object",
      "required": [
       "item_version"
      ],
      "properties": {
       "item_version": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    ]
   }
  },
  "placements": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "type": "object",
      "required": [
       "fact",
       "section_id",
       "collected_from",
       "tier"
      ]
     },
     {
      "type": "object",
      "required": [
       "item_version"
      ],
      "properties": {
       "item_version": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    ]
   }
  },
  "checks": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "type": "object",
      "required": [
       "id",
       "group",
       "severity",
       "made_by"
      ],
      "properties": {
       "made_by": {
        "enum": [
         "ai_draft",
         "rule"
        ]
       },
       "severity": {
        "enum": [
         "block",
         "warn",
         "advise",
         "sme_pending"
        ]
       }
      }
     },
     {
      "type": "object",
      "required": [
       "item_version"
      ],
      "properties": {
       "item_version": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    ]
   }
  },
  "structure": {
   "type": "object",
   "description": "structure checks run by the assembler (activity 4.1 style); a failing item is listed in unresolved, never hidden"
  },
  "unresolved": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "from",
     "item",
     "reason"
    ]
   }
  },
  "derived_fields": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "type": "object",
      "required": [
       "id",
       "calculation",
       "inputs",
       "reference",
       "executable"
      ],
      "properties": {
       "executable": {
        "type": "boolean",
        "description": "true only when the calculation has a tested helper (AIW-D264)"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "item_version"
      ],
      "properties": {
       "item_version": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    ]
   }
  },
  "review": {
   "type": "object",
   "required": [
    "decisions"
   ],
   "properties": {
    "decisions": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 }
}
