{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://expatready.local/contracts/drafting-run.v0.json",
  "title": "One AI drafting run: exact inputs, settings, outcome and evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "idempotency_key", "contract_version", "inputs", "settings", "status", "started_at"],
  "properties": {
    "run_id": { "type": "string", "minLength": 8 },
    "idempotency_key": { "type": "string", "description": "hash of inputs + settings (which include the prompt hash); a run store looks it up so a repeat can return the stored run. Only the key computation exists today; the store lookup that prevents a second draft is planned (comparison S6/S7)" },
    "contract_version": { "const": "drafting-run/v0" },
    "kind": { "enum": ["field_map", "requirements", "sections", "checks", "screen_map", "find_guide", "find_forms", "field_map_edition", "who_can_be", "pqr_picks", "qd_conditions", "masters_form", "masters_guide", "form_review"], "description": "the drafting step (W1 3.1-3.2, 3.3+3.5, 3.4, 3.8; screen_map: the inputs of an approved online version that the firm's rules could not match, F1 slice 2; find_guide and find_forms: the S4 form finder's two rounds each, P-123, P-121; field_map_edition: S6's draft and blind checker rounds of one form edition's field map, kept as the AI answer, P-138; who_can_be: Who can be in this application, its two rounds, S5 slice 3, QA-85; pqr_picks: C4.7 pre-qualification picks, its draft and blind checker rounds; qd_conditions: C4.11 step 5, the guide's conditions, its two rounds; both added for Track A PA so their launcher runs are contract-valid and replayable; masters_form and masters_guide: C3.4 library masters, a form edition's checks and document types and a guide's checks, their two rounds each; form_review: C7.5 part 2, the independent review of one filled form, its draft and blind checker rounds); absent means field_map. Added in P1 revision 4" },
    "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "hash of the exact model output; a later step reuses it only if it matches (AIW-D263)" },
    "inputs": {
      "type": "object", "additionalProperties": false, "required": ["combination", "official_files", "configuration_version"],
      "properties": {
        "combination": { "type": "string" },
        "official_files": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["file", "sha256"], "additionalProperties": false,
          "properties": { "file": { "type": "string", "not": { "pattern": "(^|/)expected/" }, "description": "shape check only; p2/guard.ts admitInput() enforces the hash-checked allowlist" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
        "configuration_version": { "type": "string" }
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false, "required": ["provider_route", "model", "prompt_version", "prompt_sha256", "max_output_tokens", "timeout_ms", "max_attempts", "budget_usd"],
      "properties": {
        "provider_route": { "const": "anthropic-api/aiw-d261-prototype-exception-aiw-d260", "description": "the only P2 route (AIW-D260 exception, AIW-D261 Anthropic API). Shape check; the runner guard (p2/guard.ts) enforces it" },
        "model": { "type": "string" }, "effort": { "type": "string" },
        "prompt_version": { "type": "string" }, "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "max_output_tokens": { "type": "integer", "minimum": 1 }, "timeout_ms": { "type": "integer", "minimum": 1000 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 }, "budget_usd": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "status": { "enum": ["running", "completed", "completed_with_unresolved", "invalid_output", "refused", "timed_out", "provider_error", "budget_exceeded", "cancelled", "superseded_by_source_change"] },
    "entries": { "type": "array", "items": { "$ref": "https://expatready.local/contracts/field-map-entry.v0.json" } },
    "attempts": { "type": "array", "items": { "type": "object", "required": ["n", "outcome"], "properties": { "n": { "type": "integer" }, "outcome": { "type": "string" }, "error": { "type": "string" }, "input_tokens": { "type": "integer" }, "output_tokens": { "type": "integer" }, "duration_ms": { "type": "integer" } } } },
    "usage": { "type": "object", "properties": { "input_tokens": { "type": "integer" }, "output_tokens": { "type": "integer" }, "cost_usd": { "type": "number" }, "duration_ms": { "type": "integer" } } },
    "started_at": { "type": "string" }, "ended_at": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "enum": ["completed", "completed_with_unresolved"] } } }, "then": { "required": ["usage", "ended_at"] } },
    { "if": { "properties": { "status": { "enum": ["completed", "completed_with_unresolved"] }, "kind": { "const": "field_map" } }, "required": ["status"] }, "then": { "required": ["entries"] } },
    { "if": { "properties": { "status": { "enum": ["completed", "completed_with_unresolved"] } }, "not": { "required": ["kind"] } }, "then": { "required": ["entries"] } },
    { "if": { "properties": { "status": { "enum": ["completed", "completed_with_unresolved"] }, "kind": { "enum": ["requirements", "sections", "checks", "screen_map", "field_map_edition", "pqr_picks", "qd_conditions", "masters_form", "masters_guide", "form_review"] } }, "required": ["status", "kind"] }, "then": { "required": ["output_sha256"] } }
  ]
}
