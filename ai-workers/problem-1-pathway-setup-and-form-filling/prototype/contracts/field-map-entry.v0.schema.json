{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://expatready.local/contracts/field-map-entry.v0.json",
  "title": "One box on one form edition: which person's which fact goes there, and how",
  "type": "object",
  "additionalProperties": false,
  "required": ["form_edition", "form_sha256", "data_path", "outcome"],
  "properties": {
    "form_edition": { "type": "string", "pattern": "^(IMM|IRM) [0-9A-Z ]+ \\([0-9]{2}-[0-9]{4}\\)$" },
    "form_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "data_path": { "type": "string", "minLength": 3, "description": "XFA data path, indices explicit, repeated rows as [n]" },
    "outcome": { "enum": ["mapped", "unresolved", "never_filled", "not_a_fact"], "description": "not_a_fact: form mechanics, not a fact (W1 3.1 ready: an explicit 'not a fact' mark); added in P1 revision 4" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "person": { "type": "string", "description": "role relative to the form's subject: subject, spouse_or_partner, parent, child, or a case person id" },
    "fact": { "type": "string", "pattern": "^[a-z][a-z_]*\\.[a-z][a-z0-9_]*$", "maxLength": 80, "description": "library field id; the one naming rule is contracts/fact-key.ts" },
    "transform": { "type": "string", "description": "named transform, e.g. code_list:imm5707.marital_status, date_part:year" },
    "row": { "type": "integer", "minimum": 0 },
    "condition": { "type": "string" },
    "unresolved_reason": { "type": "string" },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["file_sha256", "quote"],
      "properties": { "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "quote": { "type": "string", "minLength": 2 } }
    }
  },
  "allOf": [
    { "if": { "properties": { "outcome": { "const": "mapped" } } }, "then": { "required": ["person", "fact", "evidence"] } },
    { "if": { "properties": { "outcome": { "enum": ["unresolved", "never_filled", "not_a_fact"] } } }, "then": { "required": ["unresolved_reason"] } }
  ]
}
