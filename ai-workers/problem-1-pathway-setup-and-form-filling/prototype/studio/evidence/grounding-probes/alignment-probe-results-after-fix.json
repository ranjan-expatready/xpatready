{
  "scope": "Offline probes on frozen current working source, no database/browser/model calls",
  "probes": [
    {
      "id": "selected-section-question",
      "observed": {
        "configured": 1,
        "returned": 1
      },
      "expected": "Reconcile configured-section intent with unused-question pruning; this observation alone is not a confirmed material defect",
      "defect": false
    },
    {
      "id": "mapped-question-control",
      "observed": {
        "returned": [
          "person.field_a"
        ]
      },
      "expected": "The same question is returned when a form map reads it",
      "defect": false
    },
    {
      "id": "question-condition-dependency",
      "observed": {
        "waiting_questions": [
          {
            "fact": "person.condition_flag",
            "status": "needs an answer"
          },
          {
            "fact": "person.field_a",
            "status": "hidden by a condition"
          }
        ],
        "deciders": [
          {
            "fact": "person.condition_flag",
            "about": "principal",
            "about_label": "Principal",
            "meaning": "Condition flag",
            "value_type": "yes_no",
            "decides": [
              "whether \"Field A\" is asked"
            ]
          }
        ],
        "after_external_answer": [
          {
            "fact": "person.condition_flag",
            "status": "answered"
          },
          {
            "fact": "person.field_a",
            "status": "needs an answer"
          }
        ]
      },
      "expected": "The configured deciding question is available before its dependent question needs it",
      "defect": false
    },
    {
      "id": "publish-hide-required-form-input",
      "observed": {
        "form_applies": true,
        "question_status": "hidden by a condition",
        "validation_problems": [
          {
            "level": "error",
            "where": "Questions",
            "item": "person.field_a",
            "message": "Hiding a value a form reads: the question for person.field_a is hidden when \"its condition\", but FORM-A reads it whenever the form applies. Make the form or its boxes apply under the same condition, or remove the question's condition."
          }
        ]
      },
      "expected": "W1 3.4 blocks publishing a placement that hides a field read by an applicable form; this offline probe tests the publication validator, not a database release",
      "defect": false
    },
