// front-office-compliance.prisma: conflict checks, identity checks. Owner: Lead B (front office).
// One file per area (DB-SPLIT, studio/DEVELOPING.md): a new module adds its own file here; never edit another area's file without its owner.
//
// FO-13 (P-579, P-584 (8), P-599, P-600; BACKLOG row FO-13 and its brief, which wins: no complaint tables here, they are
// PF-21's platform register; contracts platform-and-front-office-contracts-2026-11-14.md §0 and §7 binding; case-side
// contract v0.1 §3.1 PartySearchPort). Schema only: the conflict check's API is FO-13c, the identity check's FO-13i.
// The duties read (Code of Professional Conduct for College Licensees, SOR/2022-128, s. 15, 16 conflicts of interest,
// s. 24(2)(a) identity, s. 24(3)(o) the retainer's disclosure); legal reading Unconfirmed: no counsel.
// Like the other platform and front-office rows, these carry no workspace_id (the firm is the tenant; the demo reset
// leaves them) and firm_id is first in every index but the primary key. A row naming a staff member keys on
// (firm_id, staff id), so it can never point at another firm's staff: composite foreign keys, RESTRICT on delete and
// update, to platform_staff (firm_id, id); the firm to platform_firm (the back-relation lines on platform.prisma).
// person_id, company_id and prospect_id name FO-1a's fo_person, fo_company and fo_prospect, which are not on main yet:
// they are uuids with no foreign key here, and FO-1k adds those keys after FO-1a (rows rev 16).
// Rules Prisma cannot say are in the migration 20261114190000_fo13_compliance_tables: the result and disclosure rules,
// the hidden-matches confirmation, the matches' shape, the last-4-characters-only document number, what may change
// after a check is written (a conflict check: once, the confirmation and the consent; an identity check: nothing),
// and that neither is ever deleted. Every list marked Sample is Sample until the immigration expert or the founder sets it.

/// The outcome of a conflict-of-interest check (Code s. 15, 16; FO-13c). POTENTIAL_CONFLICT needs the disclosure text
/// the client will read in the retainer (s. 24(3)(o)) and later the client's written consent; CONFLICT_CANNOT_ACT stops
/// the engagement (s. 15(2), 16(1)).
enum FoConflictResult {
  NO_CONFLICT
  POTENTIAL_CONFLICT
  CONFLICT_CANNOT_ACT
}

/// Whose conflict is checked: a person or a company (FO-1a's two kinds of party).
enum FoConflictPartyKind {
  PERSON
  COMPANY
}

/// How a person's identity was verified (Code s. 24(2)(a)).
enum FoIdentityMethod {
  IN_PERSON
  VIDEO
  DOCUMENT_COPY
  OTHER
}

/// The kind of identity document seen. Sample list.
enum FoIdentityDocumentType {
  PASSPORT
  NATIONAL_IDENTITY_CARD
  DRIVERS_LICENCE
  PERMANENT_RESIDENT_CARD
  OTHER_GOVERNMENT_PHOTO_ID
}

/// A detail of the person corroborated during the check (Code s. 24(2)(a)).
enum FoIdentityDetail {
  NAME
  HOME_ADDRESS
  PHONE
  EMAIL
  BUSINESS_DETAILS
}

/// One conflict-of-interest check on a party (FO-13c records it; Code s. 15, 16). The searched terms and the visible
/// matches are what the checker saw, as found; `matches` is a JSON array, one object per match: { source: FRONT_OFFICE
/// | CASE, kind, recordId, caseId?, caseNumber?, displayName?, matchedOn: [NAME | EMAIL | PHONE], score? } (kinds: the
/// front office's LEAD, PROSPECT, PERSON, COMPANY, COMPANY_CONTACT and PartySearchPort's CLIENT, APPLICANT,
/// FAMILY_MEMBER, SPONSOR, EMPLOYER, OTHER_PARTY). `hiddenCount` is the matches the checker could not see
/// (PartySearchPort's hidden_count): while it is above 0 the check holds no result, or a result other than NO_CONFLICT,
/// until another staff member who may see them confirms (`confirmedBy`, `confirmedAt`; contract v0.1 §3.1). Written
/// once; afterwards only the confirmation (with the result it confirms) and the written-consent reference are added,
/// once each. Never deleted: a changed party asks for a new check.
model FoConflictCheck {
  id                String              @id @default(uuid()) @db.Uuid
  firmId            String              @map("firm_id") @db.Uuid
  partyKind         FoConflictPartyKind @map("party_kind")
  /// FO-1a's fo_person (no foreign key until FO-1k).
  personId          String?             @map("person_id") @db.Uuid
  /// FO-1a's fo_company (no foreign key until FO-1k).
  companyId         String?             @map("company_id") @db.Uuid
  /// The engagement the check is for, when there is one: FO-1a's fo_prospect (no foreign key until FO-1k).
  prospectId        String?             @map("prospect_id") @db.Uuid
  searchedName      String?             @map("searched_name")
  searchedEmail     String?             @map("searched_email")
  searchedPhone     String?             @map("searched_phone")
  matches           Json                @default("[]")
  hiddenCount       Int                 @default(0) @map("hidden_count")
  /// Empty only while hidden matches wait for a confirmation.
  result            FoConflictResult?
  disclosureText    String?             @map("disclosure_text")
  /// Where the client's written consent is (the signed retainer's id or file key); a potential conflict only.
  writtenConsentRef String?             @map("written_consent_ref")
  checkedBy         String              @map("checked_by") @db.Uuid
  checkedAt         DateTime            @default(now()) @map("checked_at") @db.Timestamptz
  confirmedBy       String?             @map("confirmed_by") @db.Uuid
  confirmedAt       DateTime?           @map("confirmed_at") @db.Timestamptz

  firm      PlatformFirm   @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checker   PlatformStaff  @relation("FoConflictCheckedBy", fields: [firmId, checkedBy], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)
  confirmer PlatformStaff? @relation("FoConflictConfirmedBy", fields: [firmId, confirmedBy], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([firmId, personId, checkedAt])
  @@index([firmId, companyId, checkedAt])
  @@index([firmId, prospectId])
  @@map("fo_conflict_check")
}

/// One identity check on a person (FO-13i records it; Code s. 24(2)(a)): how it was done, the document seen (its type,
/// issuing country, expiry and only the last 4 characters of its number, never the full number), an optional copy kept
/// through FilesPort (its key and sha256, never in a log or an email), the details corroborated, who checked and when.
/// Insert-only: a correction is a new check.
model FoIdentityCheck {
  id                  String                  @id @default(uuid()) @db.Uuid
  firmId              String                  @map("firm_id") @db.Uuid
  /// FO-1a's fo_person (no foreign key until FO-1k).
  personId            String                  @map("person_id") @db.Uuid
  method              FoIdentityMethod
  /// What OTHER was; a note on any other method.
  methodDetail        String?                 @map("method_detail")
  documentType        FoIdentityDocumentType? @map("document_type")
  /// ISO 3166-1 alpha-2, upper case.
  issuingCountry      String?                 @map("issuing_country") @db.Char(2)
  documentExpiry      DateTime?               @map("document_expiry") @db.Date
  /// The last 4 characters of the document number, upper-case letters and digits; never more.
  documentNumberLast4 String?                 @map("document_number_last4") @db.VarChar(4)
  copyFileKey         String?                 @map("copy_file_key")
  copySha256          String?                 @map("copy_sha256")
  detailsCorroborated FoIdentityDetail[]      @map("details_corroborated")
  checkedBy           String                  @map("checked_by") @db.Uuid
  checkedAt           DateTime                @default(now()) @map("checked_at") @db.Timestamptz

  firm    PlatformFirm  @relation(fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checker PlatformStaff @relation("FoIdentityCheckedBy", fields: [firmId, checkedBy], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([firmId, personId, checkedAt])
  @@map("fo_identity_check")
}
