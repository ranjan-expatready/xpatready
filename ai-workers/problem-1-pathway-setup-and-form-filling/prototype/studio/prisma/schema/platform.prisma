// platform.prisma — firms, plans, subscriptions, staff, roles, settings, sign-up links, webhook receipts, module events. Owner: Lead B (platform).
// One file per area (DB-SPLIT, studio/DEVELOPING.md): a new module adds its own file here; never edit another area's file without its owner.
//
// PF-3 (P-558, P-559; contracts platform-and-front-office-contracts-2026-11-14.md §0, §1.1, §1.2, §7 binding). Platform rows
// are not in the demo workspace: the firm is the tenant, so they carry no workspace_id and the demo reset (which deletes
// one workspace's rows) leaves them as they are. Every table carries firm_id first in an index except the catalogues
// (platform_plan, platform_role_permission, platform_setting_definition). Every read and write goes through
// api/src/platform/firm-scope.ts. Rules Prisma cannot say (immutable country, insert-only events, single-use links, one
// open invitation, lower-case emails) are in the migration 20261114015002_pf3_platform_tables. No audit table here: the
// one trail is audit_event (AUD-1, contracts §7). Every price and limit here is Sample until the founder sets it.
// Rows naming a staff member (licence record, role grant, session revocation) key on (firm_id, staff_id), so a firm's row
// can never point at another firm's person.

/// Firm states (contracts §7, SA-2-4, -7, -21): "overdue" is an indicator on the subscription, not a firm state; exit is
/// cancel at period end → hold → deleted after 90 days; there is no CLOSED by us.
enum PlatformFirmStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  PAYMENT_HOLD
  SECURITY_LOCK
  ABANDONED
  DELETED
}

/// Subscription statuses (contracts §7, SA-4-11, SA-3-46).
enum PlatformSubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  PAYMENT_HOLD
  ENDED
}

/// A staff member's state. Invitations are their own table (platform_invitation), so a person becomes a staff row when
/// they accept. Seats used = ACTIVE + SUSPENDED staff + open invitations (SA-3-41, AG-1-13).
enum PlatformStaffStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// The six starter roles (SA6-D5, AG-1-17; contracts §7): several per person, access is the sum of their keys. There is no
/// representative role: a licence is one platform_staff_credential on the person.
enum PlatformRole {
  OWNER
  ADMIN
  CASE_MANAGER
  CASE_OFFICER
  BILLING_FINANCE
  READ_ONLY
}

/// A firm (contracts §1.1 as changed by §7; SA-2-1, -9, -24, -25). key is the firm key cases already carry
/// (runtime_case.firm_key): the Sample firms keep `sample-firm` and `sample-solo` (P-559 (4)). country_code never
/// changes, nor does key (cases carry it; triggers); contact_email is lower case and belongs to one firm.
model PlatformFirm {
  id              String             @id @default(uuid()) @db.Uuid
  key             String             @unique
  operatingName   String             @map("operating_name")
  legalName       String?            @map("legal_name")
  countryCode     String             @map("country_code") @db.Char(2)
  status          PlatformFirmStatus @default(PROVISIONING)
  ownerName       String?            @map("owner_name")
  ownerEmail      String?            @map("owner_email")
  ownerPhone      String?            @map("owner_phone")
  /// The business address (needed for tax, SA-4-52): unit, street_number, street_name, city, province_state,
  /// postal_code, country, phone — the shape samples/firms.json's office uses.
  businessAddress Json?              @map("business_address")
  billingEmail    String?            @map("billing_email")
  contactEmail    String             @unique @map("contact_email")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  settings      PlatformFirmSetting[]
  subscriptions PlatformSubscription[]
  signupLinks   PlatformSignupLink[]
  staff         PlatformStaff[]
  credentials   PlatformStaffCredential[]
  grants        PlatformRoleGrant[]
  invitations   PlatformInvitation[]
  revocations   PlatformSessionRevocation[]
  receipts      WebhookReceipt[]
  events        ModuleEvent[]
  foConsultationTypes FoConsultationType[] // FO-1b back-relation (front-office-booking.prisma), Lead B's OK on #1741

  @@map("platform_firm")
}

/// A registered setting (contracts §7 "Firm settings"): its key, its value's JSON schema (written from the zod schema the
/// code registers in api/src/platform/settings.ts), its default and the permission key that may change it. A catalogue:
/// no firm_id.
model PlatformSettingDefinition {
  key              String   @id
  ownerModule      String   @map("owner_module")
  description      String
  valueSchema      Json     @map("value_schema")
  defaultValue     Json     @map("default_value")
  changePermission String   @map("change_permission")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  values PlatformFirmSetting[]

  @@map("platform_setting_definition")
}

/// One firm's value for one registered setting; an unset key reads its definition's default. Every change writes one
/// audit_event line in its transaction (api/src/platform/settings.ts).
model PlatformFirmSetting {
  firmId    String   @map("firm_id") @db.Uuid
  key       String
  value     Json
  changedBy String   @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz

  firm       PlatformFirm              @relation(fields: [firmId], references: [id], onDelete: Restrict)
  definition PlatformSettingDefinition @relation(fields: [key], references: [key], onDelete: Restrict)

  @@id([firmId, key])
  @@map("platform_firm_setting")
}

/// The plan catalogue (no firm_id). Seat limits and prices are Sample; trial_days Sample 14 (SA-4-11). Prices stay empty
/// until the founder sets them; Stripe price ids come with PF-5.
model PlatformPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  name               String
  seatsLimit         Int      @map("seats_limit")
  trialDays          Int      @default(14) @map("trial_days")
  monthlyPriceCents  Int?     @map("monthly_price_cents")
  yearlyPriceCents   Int?     @map("yearly_price_cents")
  currency           String   @default("CAD") @db.Char(3)
  stripeMonthlyPrice String?  @map("stripe_monthly_price_id")
  stripeYearlyPrice  String?  @map("stripe_yearly_price_id")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriptions PlatformSubscription[]

  @@map("platform_plan")
}

/// A firm's subscription to us (contracts §7, SA-4). No seat copy: seats come from the plan. At most one subscription per
/// firm that has not ENDED (migration: partial unique index).
model PlatformSubscription {
  id                   String                     @id @default(uuid()) @db.Uuid
  firmId               String                     @map("firm_id") @db.Uuid
  planId               String                     @map("plan_id") @db.Uuid
  status               PlatformSubscriptionStatus @default(TRIAL)
  stripeCustomerId     String?                    @map("stripe_customer_id")
  stripeSubscriptionId String?                    @unique @map("stripe_subscription_id")
  trialEndsAt          DateTime?                  @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd     DateTime?                  @map("current_period_end") @db.Timestamptz
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  firm PlatformFirm @relation(fields: [firmId], references: [id], onDelete: Restrict)
  plan PlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([firmId, status])
  @@map("platform_subscription")
}

/// A private single-use sign-up link (contracts §7, founder question 2's recommendation; built either way): one email
/// and one country, 14 days. firm_id is the firm made with it, set once when it is used (single use: a trigger).
model PlatformSignupLink {
  id          String    @id @default(uuid()) @db.Uuid
  firmId      String?   @map("firm_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  email       String
  countryCode String    @map("country_code") @db.Char(2)
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz

  firm PlatformFirm? @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@index([firmId])
  @@map("platform_signup_link")
}

/// A staff member (contracts §1.2, §7). actor_id is the simulated id the case side already uses (`user-R`, …) for the
/// seeded Sample staff: the bridge of the identity join, unique when present. identity_subject is the Cognito `sub` or
/// the local stand-in's id (PF-4). Email is lower case, unique in the firm (AG01 gap check).
model PlatformStaff {
  id                 String              @id @default(uuid()) @db.Uuid
  firmId             String              @map("firm_id") @db.Uuid
  email              String
  familyName         String?             @map("family_name")
  givenNames         String?             @map("given_names")
  displayName        String              @map("display_name")
  identitySubject    String?             @unique @map("identity_subject")
  actorId            String?             @unique @map("actor_id")
  status             PlatformStaffStatus @default(ACTIVE)
  deactivationReason String?             @map("deactivation_reason")
  lastSignInAt       DateTime?           @map("last_sign_in_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  firm        PlatformFirm                @relation(fields: [firmId], references: [id], onDelete: Restrict)
  credential  PlatformStaffCredential?
  grants      PlatformRoleGrant[]
  revocations PlatformSessionRevocation[]
  foAvailability FoAvailability[] // FO-1b back-relations (front-office-booking.prisma), Lead B's OK on #1741
  foTimeOff      FoTimeOff[]
  foBookings     FoBooking[]

  @@unique([firmId, email])
  /// The target of the (firm_id, staff_id) keys below: a row of firm A can never point at firm B's staff (break B-2).
  @@unique([firmId, id])
  @@map("platform_staff")
}

/// A person's licence record (AG-1-30, -31; AG01-29(8): one per person): representative type, licensing body, licence
/// number. Never checked against a register (AG1-D19); never in a log line, event payload or email (PF-4 tests).
model PlatformStaffCredential {
  id                 String   @id @default(uuid()) @db.Uuid
  firmId             String   @map("firm_id") @db.Uuid
  staffId            String   @map("staff_id") @db.Uuid
  representativeType String   @map("representative_type")
  licensingBody      String   @map("licensing_body")
  licenceNumber      String   @map("licence_number")
  updatedBy          String   @map("updated_by")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  firm  PlatformFirm  @relation(fields: [firmId], references: [id], onDelete: Restrict)
  staff PlatformStaff @relation(fields: [firmId, staffId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)

  /// One licence record per person (a staff member is in one firm, so (firm, staff) is the person).
  @@unique([firmId, staffId])
  @@map("platform_staff_credential")
}

/// A role given to a staff member. Ending a grant keeps its row (ended_at, end_reason); at most one live grant per person
/// and role (migration: partial unique index).
model PlatformRoleGrant {
  id        String       @id @default(uuid()) @db.Uuid
  firmId    String       @map("firm_id") @db.Uuid
  staffId   String       @map("staff_id") @db.Uuid
  role      PlatformRole
  grantedBy String       @map("granted_by")
  grantedAt DateTime     @default(now()) @map("granted_at") @db.Timestamptz
  endedAt   DateTime?    @map("ended_at") @db.Timestamptz
  endedBy   String?      @map("ended_by")
  endReason String?      @map("end_reason")

  firm  PlatformFirm  @relation(fields: [firmId], references: [id], onDelete: Restrict)
  staff PlatformStaff @relation(fields: [firmId, staffId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([firmId, staffId])
  @@map("platform_role_grant")
}

/// The keys each starter role holds (a catalogue: no firm_id). Seeded by the migration from SA-06 v3.15 §10b, whose
/// per-role counts match its Appendix C (Owner 231, Admin 213, Case Manager 145, Case Officer 99, Billing / Finance 46,
/// Read-only 40). Routes check keys, default deny (SA-6-14, AG-1-19); roles only bundle keys.
model PlatformRolePermission {
  role          PlatformRole
  permissionKey String       @map("permission_key")

  @@id([role, permissionKey])
  @@map("platform_role_permission")
}

/// An invitation (contracts §7: 72 hours, list, resend voids the old link, revoke). One open invitation per firm and
/// email (migration: partial unique index over the rows neither accepted nor revoked). The token is kept only as a hash.
model PlatformInvitation {
  id         String         @id @default(uuid()) @db.Uuid
  firmId     String         @map("firm_id") @db.Uuid
  email      String
  roles      PlatformRole[]
  tokenHash  String         @unique @map("token_hash")
  invitedBy  String         @map("invited_by")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz
  acceptedAt DateTime?      @map("accepted_at") @db.Timestamptz
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz

  firm PlatformFirm @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@index([firmId, email])
  @@map("platform_invitation")
}

/// Tokens a staff member was issued before revoked_at are refused (deactivation, one session at a time; PF-4).
model PlatformSessionRevocation {
  id        String   @id @default(uuid()) @db.Uuid
  firmId    String   @map("firm_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  revokedAt DateTime @default(now()) @map("revoked_at") @db.Timestamptz
  reason    String

  firm  PlatformFirm  @relation(fields: [firmId], references: [id], onDelete: Restrict)
  staff PlatformStaff @relation(fields: [firmId, staffId], references: [firmId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([firmId, staffId, revokedAt])
  @@map("platform_session_revocation")
}

/// A webhook stored once by its service's own event id (contracts §0.4); a repeat is answered 200 and ignored. firm_id is
/// empty until the verified event is matched to a firm (an event for a customer we cannot match is still stored once).
model WebhookReceipt {
  id         String    @id @default(uuid()) @db.Uuid
  firmId     String?   @map("firm_id") @db.Uuid
  service    String
  eventId    String    @map("event_id")
  receivedAt DateTime  @default(now()) @map("received_at") @db.Timestamptz
  handledAt  DateTime? @map("handled_at") @db.Timestamptz
  outcome    String?

  firm PlatformFirm? @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@unique([service, eventId])
  @@index([firmId, receivedAt])
  @@map("webhook_receipt")
}

/// The transactional outbox to the case side (contracts §0.5): written in the transaction of the change that causes it,
/// insert-only (a trigger refuses update, delete and truncate). seq is the read cursor (`GET /api/platform/events?after=`):
/// a trigger gives it under one lock held to commit, so seq follows commit order and a reader past n never misses a later
/// commit below n (a writer's own seq is replaced). Delivery is at least once and consumers are idempotent by id, so
/// delivery is the consumer's cursor, not a column here.
model ModuleEvent {
  id         String   @id @default(uuid()) @db.Uuid
  seq        BigInt   @unique @default(autoincrement())
  firmId     String   @map("firm_id") @db.Uuid
  type       String
  version    Int      @default(1)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  subjectId  String   @map("subject_id")
  payload    Json

  firm PlatformFirm @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@index([firmId, seq])
  @@map("module_event")
}
