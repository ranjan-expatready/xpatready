// Product Studio prototype database (D275/D276). PostgreSQL through Prisma, as in the team's backend.
//
// Model and column names follow the team's pack models in
// code/ERv2-sanitized@22f1d12-2026-10-19/apps/api/prisma/models/country-pack-*.prisma
// (CanonicalField, ProgramDef, LogicalSection, SectionQuestion, DocumentType, DocumentRequirement,
// GovFormDef, FormEdition, FormFieldMap, Predicate, ConditionEffect, AttachMode) so the team can map each
// prototype record onto its own. Deliberate simplifications, reported rather than hidden:
//  - one table per definition with version/status/supersedesId columns (the team splits some into a
//    durable master plus a version child);
//  - every row carries workspaceId: the disposable demo workspace is the reset boundary (D274);
//  - no tenancy, row-level security, encryption seams or effective dating; prototype only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DefinitionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  RETIRED
}

enum ProgramNodeKind {
  PATHWAY
  PROGRAM
  STREAM
  CATEGORY
}

enum FieldDataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  ENUM
  COMPOSITE
}

enum FieldScope {
  CLIENT_LEVEL
  CASE_LEVEL
}

enum ConditionEffect {
  SHOW
  HIDE
  REQUIRE
  OPTIONAL
}

enum AttachMode {
  COMBINATION_MANDATORY
  ANSWER_CONDITIONAL
}

enum Origin {
  IMPORTED_RELEASE
  AI_PROPOSAL
  HUMAN
  /// F1: proposed by a deterministic match (PDF twin, form path, name or alias; no AI), accepted by a person.
  CODE_MATCH
}

enum SourceBasis {
  SOURCE_BACKED
  ILLUSTRATIVE
}

/// F1 (P-61 §2): how one form line of a combination is filed. Signature method and the combination's filing method are
/// worked out from it (engine/channels.ts), never stored.
enum FilingChannel {
  PDF_UPLOAD
  ONLINE
  SIGNED_PDF_UPLOAD
}

/// F1 (challenge point 2): an edition is the PDF file, or an online version read from captured portal screens.
enum EditionChannel {
  PDF
  ONLINE
}

/// The disposable demo workspace. Reset deletes every row that belongs to it and its working files.
model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("workspace")
}

// ─── Programs and combinations ──────────────────────────────────────────────────────────────────

/// Pathway › program › stream › category, as the team's ProgramDef (parentNodeKey, not a self-FK).
model ProgramDef {
  id             String          @id @default(uuid()) @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  programNodeKey String          @map("program_node_key")
  parentNodeKey  String?         @map("parent_node_key")
  nodeKind       ProgramNodeKind @map("node_kind")
  label          String
  description    String?
  sourceBasis    SourceBasis     @default(SOURCE_BACKED) @map("source_basis")
  /// PATHWAY only (SA-1B-50/51): who the client is, INDIVIDUAL or CORPORATE. Client type comes from the pathway.
  clientType     String?         @map("client_type")
  /// Category / sub-category (SA-1B-51): locations a case may choose when it is opened (inside/outside Canada is a
  /// case detail, not a level). The prototype's sourced rows allow "outside_canada" only.
  allowedLocations String[]      @default([]) @map("allowed_locations")
  displayOrder   Int             @default(0) @map("display_order")
  /// Screen 01 (P-26): a plain label under the name for a route step or a supporting application, for example
  /// "Step 1 of 2 · followed by Permanent residence application" or "Supported by: Corporate › LMIA". A label only:
  /// no link record and no behaviour behind it yet.
  linkLabel      String?         @map("link_label")
  createdBy      String          @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  combination Combination?

  @@unique([workspaceId, programNodeKey])
  @@map("program_def")
}

/// The combination: one filing type at the last level present (a category without sub-categories, or a sub-category),
/// SA-1B-55. Exactly one per leaf node (unique programDefId); it owns one configuration: forms, document requirements,
/// rules, checks and section selection. `participants` (who it applies to) is an adapter kept until Screen 03 moves
/// people onto lines as roles.
model Combination {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @map("workspace_id") @db.Uuid
  programDefId   String      @map("program_def_id") @db.Uuid
  combinationKey String      @map("combination_key")
  label          String
  description    String?
  /// [{ role: "principal"|"spouse_or_partner"|"child"|"representative", label, min, max }]
  participants   Json
  sourceBasis    SourceBasis @default(SOURCE_BACKED) @map("source_basis")
  basisNote      String?     @map("basis_note")
  /// F1 (challenge point 4): the one portal this filing goes through (contracts/forms.ts PORTALS, Sample until the
  /// immigration expert confirms). Every Online line uses the form's online version captured from this portal.
  portalKey      String?     @map("portal_key")
  createdBy      String      @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  program      ProgramDef            @relation(fields: [programDefId], references: [id], onDelete: Restrict)
  attachments  SourceAttachment[]
  forms        CombinationForm[]
  sections     SqrSectionSelection[]
  requirements DocumentRequirement[]
  rules        Predicate[]
  checks       Check[]
  releases     ConfigRelease[]
  jobs         DraftingJob[]
  cases        Case[] // runtime lane (R1)

  @@unique([workspaceId, combinationKey])
  @@unique([programDefId])
  @@map("combination")
}

// ─── Sources and forms ──────────────────────────────────────────────────────────────────────────

/// An uploaded official form, checklist, guide or page. Only files whose bytes match the official manifest
/// are "recognised"; anything else is held (no AI drafting, no reading).
model SourceAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  combinationId  String   @map("combination_id") @db.Uuid
  kind           String
  fileName       String   @map("file_name")
  storedPath     String   @map("stored_path")
  sha256         String
  bytes          Int
  recognised     Boolean
  officialFile   String?  @map("official_file")
  edition        String?
  approval       String?
  status         String
  statusDetail   String?  @map("status_detail")
  /// MANUAL (a person chose the file) or SAMPLE (the Load sample inputs button chose it); same handling.
  uploadedVia    String   @map("uploaded_via")
  uploadedBy     String   @map("uploaded_by")
  inventoryFile  String?  @map("inventory_file")
  inventorySummary Json?  @map("inventory_summary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sha256])
  @@map("source_attachment")
}

model GovFormDef {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  formKey     String  @map("form_key")
  displayName String  @map("display_name")
  /// "data_form" (an XFA form the system fills) or "document" (a checklist or instructions)
  formKind    String  @default("data_form") @map("form_kind")

  editions FormEdition[]
  usedBy   CombinationForm[]

  @@unique([workspaceId, formKey])
  @@map("gov_form_def")
}

model FormEdition {
  id             String  @id @default(uuid()) @db.Uuid
  workspaceId    String  @map("workspace_id") @db.Uuid
  govFormDefId   String  @map("gov_form_def_id") @db.Uuid
  editionLabel   String  @map("edition_label")
  officialFile   String? @map("official_file")
  sha256         String?
  inventoryFile  String? @map("inventory_file")
  dataBoundBoxes Int     @default(0) @map("data_bound_boxes")
  /// Screen 01 uploads (P-25): the uploaded PDF kept outside the web root, so "+ Add" can attach it to another row.
  storedPath     String? @map("stored_path")
  /// F1: PDF (the file) or ONLINE (an online version: the portal twin of an approved capture, P-66). An online version's
  /// identity is contentSha256, the fingerprint of its normalised screens (saved pages differ byte for byte per save);
  /// sha256 stays the PDF's file checksum. inventoryFile holds the twin (screens, inputs, options) for both channels.
  channel        EditionChannel @default(PDF)
  portalKey      String?   @map("portal_key")
  capturedOn     DateTime? @map("captured_on") @db.Date
  /// The date the online version must be checked again (validator: an Online line needs a version within it).
  recheckBy      DateTime? @map("recheck_by") @db.Date
  contentSha256  String?   @map("content_sha256")

  form GovFormDef     @relation(fields: [govFormDefId], references: [id], onDelete: Cascade)
  maps FormFieldMap[]

  @@unique([workspaceId, editionLabel])
  @@map("form_edition")
}

/// The one form intake (P-51): one row per file a person (or the sample loader) handed in, with what was read from the
/// file and the outcome. Held rows wait for a person: a new edition of a form already in the library (impact review,
/// P-32/P-38; never attached or used silently) or a file whose code and edition could not be read.
model IntakeItem {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  /// The combination it was uploaded on (door 1); null for the Forms library's own "Add forms" (door 2, Screen 04).
  combinationId String?  @map("combination_id") @db.Uuid
  fileName      String   @map("file_name")
  storedPath    String   @map("stored_path")
  sha256        String
  bytes         Int
  /// form · checklist · guide · unknown, read from the file
  kind          String
  code          String?
  title         String?
  editionLabel  String?  @map("edition_label")
  published     String?
  /// in_library · added · attached · new_edition_held · held · refused
  outcome       String
  /// HELD (waits for a person) or DONE
  status        String
  reason        String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, status])
  @@index([workspaceId, sha256])
  @@map("intake_item")
}

/// Which forms a combination files, for whom, and when (always or under a condition).
model CombinationForm {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  combinationId String           @map("combination_id") @db.Uuid
  govFormDefId  String           @map("gov_form_def_id") @db.Uuid
  lineageKey    String           @map("lineage_key")
  who           String
  attachMode    AttachMode       @map("attach_mode")
  predicateJson Json?            @map("predicate_json")
  conditionPlain String?         @map("condition_plain")
  sourceQuote   String?          @map("source_quote")
  version       Int              @default(1)
  status        DefinitionStatus
  supersedesId  String?          @map("supersedes_id") @db.Uuid
  origin        Origin
  /// F1 (P-61 §2): how this line is filed. Existing lines stay PDF upload (today's behaviour).
  channel       FilingChannel    @default(PDF_UPLOAD)
  updatedBy     String           @map("updated_by")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  form        GovFormDef  @relation(fields: [govFormDefId], references: [id], onDelete: Cascade)

  @@unique([combinationId, lineageKey, version])
  @@map("combination_form")
}

/// One box of one form edition and the fact that fills it. The team stores entries as Json on
/// FormFieldMap; rows here so reuse ("which boxes read this field, for whom") is a query.
model FormFieldMap {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  formEditionId     String           @map("form_edition_id") @db.Uuid
  dataPath          String           @map("data_path")
  caption           String?
  heading           String?
  outcome           String
  person            String?
  row               Int?
  canonicalFieldKey String?          @map("canonical_field_key")
  transform         String?
  condition         String?
  confidence        String?
  evidenceQuote     String?          @map("evidence_quote")
  reason            String?
  version           Int              @default(1)
  status            DefinitionStatus
  supersedesId      String?          @map("supersedes_id") @db.Uuid
  origin            Origin
  draftingRunId     String?          @map("drafting_run_id")
  /// F1, online versions: the portal screen and the input's place on it (dataPath holds the page's element id or name).
  screenKey         String?          @map("screen_key")
  screenOrder       Int?             @map("screen_order")
  inputOrder        Int?             @map("input_order")
  /// F1 (challenge point 3): { map: { answer-list value key: this form field's code }, unused: [codes of this form
  /// field that no value fills] }. `map` is the team's ENUM transform map (onMissing REFUSE).
  optionMap         Json?            @map("option_map")
  updatedBy         String           @map("updated_by")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  edition FormEdition @relation(fields: [formEditionId], references: [id], onDelete: Cascade)

  @@unique([formEditionId, dataPath, version])
  @@index([workspaceId, canonicalFieldKey])
  @@map("form_field_map")
}

// ─── The shared library ─────────────────────────────────────────────────────────────────────────

/// One meaning, independent of whose value it is (the same key for the applicant's and the partner's
/// date of birth). Values for people and cases are never stored here.
model CanonicalField {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  canonicalFieldKey String           @map("canonical_field_key")
  version           Int
  status            DefinitionStatus
  supersedesId      String?          @map("supersedes_id") @db.Uuid
  meaning           String
  valueType         String           @map("value_type")
  dataType          FieldDataType    @map("data_type")
  scope             FieldScope
  subjectKind       String           @map("subject_kind")
  origin            Origin
  sourceRef         String?          @map("source_ref")
  note              String?
  /// P-65: labels this field carries on forms and portal screens ("Date of birth", "DOB"), and the ids of fields merged
  /// into it. Matching tries form path, then these, before any AI.
  aliases           String[]         @default([])
  /// P-65 reviewed merge: set on the merged-away field's closing version; its id redirects to this key.
  mergedIntoKey     String?          @map("merged_into_key")
  /// F1 (challenge point 3): the answer list a choice field takes its values from (the team's CanonicalField.enumSetId).
  answerListKey     String?          @map("answer_list_key")
  updatedBy         String           @map("updated_by")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  answers ClientCanonicalAnswer[] // runtime lane (R1): answers point at the exact field version

  @@unique([workspaceId, canonicalFieldKey, version])
  @@map("canonical_field")
}

/// F1 (challenge point 3): one list of values a choice field can take, mirroring the team's EnumSet. Each form field's
/// own codes map to these values per channel (FormFieldMap.optionMap).
model AnswerList {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  answerListKey String           @map("answer_list_key")
  version       Int
  status        DefinitionStatus
  label         String
  sourceBasis   SourceBasis      @default(ILLUSTRATIVE) @map("source_basis")
  origin        Origin
  updatedBy     String           @map("updated_by")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  values AnswerListValue[]

  @@unique([workspaceId, answerListKey, version])
  @@map("answer_list")
}

/// The team's EnumSetValue.
model AnswerListValue {
  id           String @id @default(uuid()) @db.Uuid
  answerListId String @map("answer_list_id") @db.Uuid
  valueKey     String @map("value_key")
  label        String
  sortOrder    Int    @map("sort_order")

  list AnswerList @relation(fields: [answerListId], references: [id], onDelete: Cascade)

  @@unique([answerListId, valueKey])
  @@map("answer_list_value")
}

/// P-65 reviewed merge of two shared fields: proposed by one person, applied when a different person approves. The
/// merged-away id becomes an alias that redirects; draft mappings, rules and placements move; releases stay as released.
model FieldMerge {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  keepKey      String    @map("keep_key")
  mergeKey     String    @map("merge_key")
  reason       String
  /// PROPOSED · APPLIED · REJECTED
  status       String
  proposedBy   String    @map("proposed_by")
  proposedAt   DateTime  @default(now()) @map("proposed_at") @db.Timestamptz
  decidedBy    String?   @map("decided_by")
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz
  decisionNote String?   @map("decision_note")
  /// What moved when it was applied: counts per kind of row.
  moved        Json?

  @@index([workspaceId, status])
  @@map("field_merge")
}

/// P-66 capture record: the structure of one portal application's screens (never an answer), from saved blank pages,
/// the spreadsheet template or (F2) the extension. Held until a second person approves it (P-57 amended for this kind);
/// approval makes it an online version (FormEdition, channel ONLINE). The page files themselves are not kept: only
/// their checksums and the structure read from them (a page can show a client's data as text).
model PortalCapture {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  portalKey       String    @map("portal_key")
  formKey         String    @map("form_key")
  title           String
  applicationType String?   @map("application_type")
  /// saved_page · template · extension · screenshots (P-66 §1 ways A–D)
  way             String
  /// OPEN (screens being added) · HELD (finished, waiting for a second person) · APPROVED · RETURNED · IN_LIBRARY
  /// (identical to an approved version) · ABANDONED (given up by an author; kept for the audit)
  status          String
  statusDetail    String?   @map("status_detail")
  /// The capture record (contracts/portal-capture.v1.schema.json).
  record          Json
  files           Json      @default("[]")
  /// Bumped by every write: a write that read an older revision is refused (two adds, or an add during finish).
  revision        Int       @default(0)
  contentSha256   String?   @map("content_sha256")
  /// The approved online version this capture changes, with the field-by-field difference (P-66 §2.3).
  changesEditionId String?  @map("changes_edition_id") @db.Uuid
  difference      Json?
  twinFile        String?   @map("twin_file")
  reviewFile      String?   @map("review_file")
  formEditionId   String?   @map("form_edition_id") @db.Uuid
  capturedOn      DateTime  @default(now()) @map("captured_on") @db.Date
  capturedBy      String    @map("captured_by")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz
  decisionNote    String?   @map("decision_note")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, formKey, portalKey])
  @@map("portal_capture")
}

model LogicalSection {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  sectionKey   String           @map("section_key")
  version      Int
  status       DefinitionStatus
  supersedesId String?          @map("supersedes_id") @db.Uuid
  title        String
  meaning      String?
  displayOrder Int              @default(0) @map("display_order")
  origin       Origin
  updatedBy    String           @map("updated_by")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, sectionKey, version])
  @@map("logical_section")
}

/// A question placement: which canonical field is asked in which section, for whom, from which collection
/// source, and under which condition.
model SectionQuestion {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  lineageKey        String           @map("lineage_key")
  sectionKey        String           @map("section_key")
  canonicalFieldKey String           @map("canonical_field_key")
  displayOrder      Int              @map("display_order")
  questionText      String?          @map("question_text")
  helpText          String?          @map("help_text")
  /// once_per_case | per_person | per_row
  repeats           String
  /// prospect | case | lead
  tier              String
  /// client_questionnaire | verified_document | staff_working_view | profile_record | existing_record
  collectedFrom     String           @map("collected_from")
  clientVisible     Boolean          @default(true) @map("client_visible")
  predicateJson     Json?            @map("predicate_json")
  conditionEffect   ConditionEffect? @map("condition_effect")
  conditionPlain    String?          @map("condition_plain")
  ruleOnly          Boolean          @default(false) @map("rule_only")
  version           Int
  status            DefinitionStatus
  supersedesId      String?          @map("supersedes_id") @db.Uuid
  origin            Origin
  updatedBy         String           @map("updated_by")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, lineageKey, version])
  @@index([workspaceId, canonicalFieldKey])
  @@map("section_question")
}

/// Which library sections a combination's questionnaire uses, in order (the team's SqrSectionSelection).
model SqrSectionSelection {
  id            String @id @default(uuid()) @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid
  combinationId String @map("combination_id") @db.Uuid
  sectionKey    String @map("section_key")
  sectionOrder  Int    @map("section_order")

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@unique([combinationId, sectionKey])
  @@map("sqr_section_selection")
}

model DocumentType {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  documentTypeKey String           @map("document_type_key")
  name            String
  category        String
  /// Facts a supported document of this type can supply (closes P5 finding D36 in the prototype model).
  suppliesFacts   String[]         @default([]) @map("supplies_facts")
  readerProfile   Json?            @map("reader_profile")
  version         Int
  status          DefinitionStatus
  supersedesId    String?          @map("supersedes_id") @db.Uuid
  origin          Origin
  updatedBy       String           @map("updated_by")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, documentTypeKey, version])
  @@map("document_type")
}

model DocumentRequirement {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  combinationId   String           @map("combination_id") @db.Uuid
  lineageKey      String           @map("lineage_key")
  documentTypeKey String           @map("document_type_key")
  attachMode      AttachMode       @map("attach_mode")
  predicateJson   Json?            @map("predicate_json")
  conditionPlain  String?          @map("condition_plain")
  appliesToRoles  String           @map("applies_to_roles")
  providedBy      String           @map("provided_by")
  isRequired      Boolean          @default(true) @map("is_required")
  sourceQuote     String?          @map("source_quote")
  sourceFile      String?          @map("source_file")
  note            String?
  version         Int
  status          DefinitionStatus
  supersedesId    String?          @map("supersedes_id") @db.Uuid
  origin          Origin
  updatedBy       String           @map("updated_by")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@unique([combinationId, lineageKey, version])
  @@map("document_requirement")
}

/// A reusable condition with its effect ("add form IMM 5707 for this person"), in the team's closed
/// 11-operator vocabulary (contracts/rules.ts). Evaluated deterministically; never generated code.
model Predicate {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  combinationId  String           @map("combination_id") @db.Uuid
  predicateKey   String           @map("predicate_key")
  predicateJson  Json             @map("predicate_json")
  whenPlain      String?          @map("when_plain")
  thenPlain      String           @map("then_plain")
  forWhom        String           @map("for_whom")
  sourceQuote    String?          @map("source_quote")
  version        Int
  status         DefinitionStatus
  supersedesId   String?          @map("supersedes_id") @db.Uuid
  origin         Origin
  updatedBy      String           @map("updated_by")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@unique([combinationId, predicateKey, version])
  @@map("predicate")
}

model DerivedField {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  derivedKey  String   @map("derived_key")
  calculation String
  inputs      String[]
  reference   String
  plain       String?
  executable  Boolean

  @@unique([workspaceId, derivedKey])
  @@map("derived_field")
}

model Check {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  combinationId String           @map("combination_id") @db.Uuid
  checkKey      String           @map("check_key")
  checkGroup    String           @map("check_group")
  appliesTo     String?          @map("applies_to")
  predicateJson Json?            @map("predicate_json")
  severity      String
  message       String?
  sourceQuote   String?          @map("source_quote")
  illustrative  Boolean          @default(false)
  version       Int
  status        DefinitionStatus
  supersedesId  String?          @map("supersedes_id") @db.Uuid
  origin        Origin
  updatedBy     String           @map("updated_by")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@unique([combinationId, checkKey, version])
  @@map("check_def")
}

// ─── AI drafting, normalisation, review and release ─────────────────────────────────────────────

/// One step started from the screen: read a form (local), draft its field map (guarded AI path), compare
/// with the library. mode: LOCAL | STUB | LIVE | REPLAY (REPLAY reuses a saved real run, labelled).
model DraftingJob {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  combinationId String    @map("combination_id") @db.Uuid
  attachmentId  String?   @map("attachment_id") @db.Uuid
  kind          String
  mode          String
  status        String
  message       String?
  runId         String?   @map("run_id")
  runFile       String?   @map("run_file")
  costUsd       Float?    @map("cost_usd")
  detail        Json?
  startedBy     String    @map("started_by")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz

  /// D280: the scoped AI operation this step belongs to (null for steps started before batches existed).
  batchId       String?   @map("batch_id") @db.Uuid
  /// What the step reuses or produces: source edition, operation, prompt, model and settings (see api/src/ai.ts).
  fingerprint   String?
  attempt       Int       @default(1)

  combination Combination         @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  batch       AiBatch?            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  items       NormalizationItem[]

  // A partial unique index (migration 20261021070000_ai_batches) allows one QUEUED or RUNNING step per source and
  // kind: a second launch for the same form is refused by the database, not only by a disabled button.
  @@index([batchId])
  @@map("drafting_job")
}

/// D280: one scoped AI operation launched from the catalogue, a program, a combination or a source. It groups small
/// tracked steps (read, reuse, draft) over one governed path; it never sends many forms in one prompt. The plan the
/// person saw is stored with its fingerprint; the server re-plans at launch and refuses if the scope changed.
model AiBatch {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  idempotencyKey  String    @map("idempotency_key")
  operation       String
  scopeKind       String    @map("scope_kind")
  scopeLabel      String    @map("scope_label")
  mode            String
  status          String
  message         String?
  planSha256      String    @map("plan_sha256")
  plan            Json
  spendLimitUsd   Float     @map("spend_limit_usd")
  worstCaseUsd    Float     @map("worst_case_usd")
  expectedUsd     Float?    @map("expected_usd")
  cancelRequested Boolean   @default(false) @map("cancel_requested")
  startedBy       String    @map("started_by")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz

  jobs DraftingJob[]

  @@unique([workspaceId, idempotencyKey])
  @@map("ai_batch")
}

/// One proposed canonical field from an added form, compared with the library.
/// outcome: REUSE | NEW | AMBIGUOUS | CONFLICT. decision: PENDING | ACCEPTED | CHANGED | RETURNED.
model NormalizationItem {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  formEditionId  String?  @map("form_edition_id") @db.Uuid
  proposedKey    String   @map("proposed_key")
  proposedMeaning String  @map("proposed_meaning")
  proposedType   String   @map("proposed_type")
  outcome        String
  matchedKey     String?  @map("matched_key")
  candidates     Json
  persons        String[]
  boxes          Json
  evidence       Json
  affected       Json
  reason         String
  decision       String   @default("PENDING")
  decidedKey     String?  @map("decided_key")
  decidedBy      String?  @map("decided_by")
  decisionNote   String?  @map("decision_note")
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz

  job DraftingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("normalization_item")
}

/// A frozen, hashed configuration version that case work consumes. Draft edits never change it.
model ConfigRelease {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  combinationId  String   @map("combination_id") @db.Uuid
  version        Int
  status         String
  snapshot       Json
  sha256         String
  summary        Json
  authorId       String   @map("author_id")
  submitterId    String   @map("submitter_id")
  approverId     String   @map("approver_id")
  basis          String
  releasedAt     DateTime @default(now()) @map("released_at") @db.Timestamptz
  /// The pack version this row snapshot was released in (P-23: one shared draft, one release for everything).
  packVersionId  String?  @map("pack_version_id") @db.Uuid

  combination Combination  @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  packVersion PackVersion? @relation(fields: [packVersionId], references: [id], onDelete: Restrict)
  pins        PackWorkPin[] // runtime lane (R1): cases pinned to this release

  @@unique([combinationId, version])
  @@index([packVersionId])
  @@map("config_release")
}

/// One release of the whole shared draft (the team's CountryPackVersion, P-23). Each combination whose draft changed
/// gets a frozen row snapshot (ConfigRelease) in it; unchanged combinations keep their earlier snapshot. Firms may open
/// a combination when it is in a release and passes the startable check (SA-1B-90).
model PackVersion {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  version     Int
  authorIds   String[] @map("author_ids")
  approverId  String   @map("approver_id")
  summary     Json
  releasedAt  DateTime @default(now()) @map("released_at") @db.Timestamptz

  rows ConfigRelease[]

  @@unique([workspaceId, version])
  @@map("pack_version")
}

model ReviewSubmission {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  combinationId String    @map("combination_id") @db.Uuid
  draftSha256   String    @map("draft_sha256")
  submittedBy   String    @map("submitted_by")
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  status        String
  changeSummary Json      @map("change_summary")
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz
  decisionNote  String?   @map("decision_note")

  @@map("review_submission")
}

model ReviewSignoff {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  itemRef      String   @map("item_ref")
  duty         String
  actorId      String   @map("actor_id")
  action       String
  note         String?
  at           DateTime @default(now()) @db.Timestamptz

  @@map("review_signoff")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz
  actor       String
  action      String
  entity      String
  entityKey   String?  @map("entity_key")
  summary     String
  detail      Json?
  /// The configuration row an edit belongs to (finding 2 of the 21 Oct grounding audit): review uses these events to
  /// know every author of a draft, including edits that leave no draft row (people, section selection, removals).
  combinationId String?  @map("combination_id") @db.Uuid

  @@index([workspaceId, at])
  @@index([combinationId, at])
  @@map("audit_event")
}

// ─── Sample facts for previews and PDF proof (labelled existing sample records, never AI results) ──

model SampleProfile {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  profileKey  String   @map("profile_key")
  label       String
  basis       String
  /// [{ id, role, label }]
  people      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  facts SampleFact[]

  @@unique([workspaceId, profileKey])
  @@map("sample_profile")
}

model SampleFact {
  id                String  @id @default(uuid()) @db.Uuid
  workspaceId       String  @map("workspace_id") @db.Uuid
  profileId         String  @map("profile_id") @db.Uuid
  personId          String  @map("person_id")
  canonicalFieldKey String  @map("canonical_field_key")
  row               Int?
  value             Json
  status            String
  source            String

  profile SampleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, canonicalFieldKey])
  @@map("sample_fact")
}

/// Generated output files (filled PDFs, read-back reports) of the demo workspace; deleted by reset.
model GeneratedArtifact {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  kind        String
  path        String
  sha256      String
  detail      Json?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("generated_artifact")
}

// ─── Runtime (runtime lane, R1 thin slice, P-67) ──────────────────────────────────────────────────────────────────
// A case for one released combination: its people, one current answer per person per fact, rows of repeating groups.
// Names follow the team's client spine (code/ERv2-sanitized@22f1d12-2026-10-19/apps/api/prisma/models/client-spine.prisma;
// divergences D-1…D-9 in product/screens/R1-thin-slice/plan.md §7). Constraints Prisma cannot express (one current
// answer, deferred supersede links, no self-edge) are in the migration's SQL.

/// One application for one released combination (the team has no Case table yet: its caseId columns would point here).
model Case {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  combinationId  String   @map("combination_id") @db.Uuid
  reference      String
  status         String   @default("OPEN")
  /// The simulated client login that may answer this case's questionnaire (no real sign-in in the prototype).
  clientActorId  String   @map("client_actor_id")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  idempotencyKey String?  @map("idempotency_key")

  combination  Combination       @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  pins         PackWorkPin[]
  participants CaseParticipant[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@map("runtime_case")
}

/// The release a case works from (team PackWorkPin, pinned per case and combination here). Insert-only.
model PackWorkPin {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  combinationId   String   @map("combination_id") @db.Uuid
  partyId         String   @map("party_id") @db.Uuid
  packVersionId   String?  @map("pack_version_id") @db.Uuid
  configReleaseId String   @map("config_release_id") @db.Uuid
  contentHash     String   @map("content_hash") @db.VarChar(64)
  purpose         String   @default("SQR_ADVANCE")
  revision        Int      @default(1)
  actorId         String   @map("actor_id")
  pinnedAt        DateTime @default(now()) @map("pinned_at") @db.Timestamptz

  case    Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  release ConfigRelease @relation(fields: [configReleaseId], references: [id], onDelete: Cascade)

  @@unique([caseId, combinationId, revision])
  @@map("pack_work_pin")
}

/// A person (team Party; per workspace here, per firm there).
model Party {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  kind        String   @default("PERSON")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile  PartyProfile?
  from     PartyRelationship[] @relation("PartyRelFrom")
  to       PartyRelationship[] @relation("PartyRelTo")
  subjects AnswerSubject[]

  @@index([workspaceId])
  @@map("party")
}

model PartyProfile {
  id                  String  @id @default(uuid()) @db.Uuid
  workspaceId         String  @map("workspace_id") @db.Uuid
  partyId             String  @unique @map("party_id") @db.Uuid
  displayName         String  @map("display_name")
  localePreference    String? @map("locale_preference")
  contactChannelsJson Json    @default("{}") @map("contact_channels_json")

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_profile")
}

/// Principal → spouse or partner, principal → child (open vocabulary, as the team's). Self-edge refused in SQL.
model PartyRelationship {
  id               String  @id @default(uuid()) @db.Uuid
  workspaceId      String  @map("workspace_id") @db.Uuid
  fromPartyId      String  @map("from_party_id") @db.Uuid
  toPartyId        String  @map("to_party_id") @db.Uuid
  relationshipType String  @map("relationship_type")
  role             String?

  fromParty Party @relation("PartyRelFrom", fields: [fromPartyId], references: [id], onDelete: Cascade)
  toParty   Party @relation("PartyRelTo", fields: [toPartyId], references: [id], onDelete: Cascade)

  @@index([fromPartyId])
  @@map("party_relationship")
}

/// Whom an answer is about: a person on the case, or the case itself (subjectKind "case", party = the principal).
model AnswerSubject {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  partyId     String @map("party_id") @db.Uuid
  subjectKind String @map("subject_kind")
  label       String

  party        Party                   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  participant  CaseParticipant?
  answers      ClientCanonicalAnswer[]
  records      ClientFactRecord[]

  @@map("answer_subject")
}

/// Who is on the case, in the combination's roles (the team has no case membership; D-2).
model CaseParticipant {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  caseId      String  @map("case_id") @db.Uuid
  subjectId   String  @unique @map("subject_id") @db.Uuid
  /// principal · spouse_or_partner · child · case
  role        String
  /// travelling with the application (a combination participant that "applies")
  applies     Boolean @default(true)
  order       Int

  case    Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  subject AnswerSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([caseId, order])
  @@map("case_participant")
}

/// One row of a repeating group (team ClientFactRecord; groupKey = the questionnaire section holding the group, D-5).
/// Removing a row inserts a tombstone version; nothing is deleted.
model ClientFactRecord {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  groupKey       String   @map("group_key")
  /// Stable row identity across versions (the first version's id).
  rowKey         String   @map("row_key") @db.Uuid
  order          Int
  tombstone      Boolean  @default(false)
  supersededById String?  @map("superseded_by_id") @db.Uuid
  sourceJson     Json     @map("source_json")
  effectiveAt    DateTime @default(now()) @map("effective_at") @db.Timestamptz

  subject      AnswerSubject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  supersededBy ClientFactRecord?       @relation("ClientFactRecordChain", fields: [supersededById], references: [id], onDelete: Cascade)
  supersedes   ClientFactRecord[]      @relation("ClientFactRecordChain")

  @@index([subjectId, groupKey])
  @@map("client_fact_record")
}

/// One answer about one subject for one shared field (and one row of a group). Append-only: a change inserts a new row
/// and stamps the old one superseded, in one transaction. DECLARED = typed; VERIFIED = confirmed by the officer.
model ClientCanonicalAnswer {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  partyId           String    @map("party_id") @db.Uuid
  subjectId         String    @map("subject_id") @db.Uuid
  canonicalFieldId  String    @map("canonical_field_id") @db.Uuid
  canonicalFieldKey String    @map("canonical_field_key")
  /// The repeating-group row (ClientFactRecord.rowKey) this answer belongs to; null for a single answer.
  rowKey            String?   @map("row_key") @db.Uuid
  valueJson         Json      @map("value_json")
  status            String
  effectiveAt       DateTime  @default(now()) @map("effective_at") @db.Timestamptz
  supersededById    String?   @map("superseded_by_id") @db.Uuid
  /// { channel: questionnaire | agent_view | confirm_section, actor, at }
  sourceJson        Json      @map("source_json")
  verifiedBy        String?   @map("verified_by")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz

  subject        AnswerSubject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  canonicalField CanonicalField          @relation(fields: [canonicalFieldId], references: [id], onDelete: Restrict)
  supersededBy   ClientCanonicalAnswer?  @relation("ClientCanonicalAnswerChain", fields: [supersededById], references: [id], onDelete: Cascade)
  supersedes     ClientCanonicalAnswer[] @relation("ClientCanonicalAnswerChain")

  @@index([subjectId, canonicalFieldKey])
  @@map("client_canonical_answer")
}
