model ReviewSignoff {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  itemRef      String   @map("item_ref")
  duty         String
  actorId      String   @map("actor_id")
  action       String
  note         String?
  at           DateTime @default(now()) @db.Timestamptz

  @@map("review_signoff")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz
  actor       String
  action      String
  entity      String
  entityKey   String?  @map("entity_key")
  summary     String
