// ─── Runtime (runtime lane, R1 thin slice, P-67) ──────────────────────────────────────────────────────────────────
// A case for one released combination: its people, one current answer per person per fact, rows of repeating groups.
// Names follow the team's client spine (code/ERv2-sanitized@22f1d12-2026-10-19/apps/api/prisma/models/client-spine.prisma;
// divergences D-1…D-9 in product/screens/R1-thin-slice/plan.md §7). Constraints Prisma cannot express (one current
// answer, deferred supersede links, no self-edge) are in the migration's SQL.

/// One application for one released combination (the team has no Case table yet: its caseId columns would point here).
model Case {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  combinationId  String   @map("combination_id") @db.Uuid
  /// A24-1 (P-492, CS-7, AG-7-3): the case number, C-<year opened>-<5-digit running number> (C-2026-00042), per firm and
  /// year; taken at opening from firm_case_counter by runtime_next_case_number(); never changed (a trigger refuses it).
  caseNumber     String   @map("case_number")
  /// The firm's own reference: optional since A24-1 (CS-7), unique within the firm when given.
  reference      String?
  status         String   @default("OPEN")
  /// The simulated client login that may answer this case's questionnaire (no real sign-in in the prototype).
  clientActorId  String   @map("client_actor_id")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  idempotencyKey String?  @map("idempotency_key")
  /// sha256 of the create request: a key reused with a different request is refused, never answered with another case.
  idempotencyFingerprint String? @map("idempotency_fingerprint") @db.VarChar(64)
  /// C6.11 (BR-20, SI-9): the Sample firm whose staff work this case (samples/firms.json); staff of another firm reach
  /// none of its cases. Cases opened before C6.11 belong to the Sample firm.
  firmKey        String   @default("sample-firm") @map("firm_key")

  /// A case keeps its combination: deleting a combination with cases is refused (reset deletes cases first).
  combination  Combination       @relation(fields: [combinationId], references: [id], onDelete: Restrict)
  pins         PackWorkPin[]
  participants CaseParticipant[]
  forms        FormInstance[]
  snapshots    AnswerSnapshot[]
  team         CaseTeamMember[]
  groups       SubmissionGroup[]
  filings      Filing[]
  assessments  Assessment[] // C6.9
  filingItems  FilingItem[]
  checklistLines ChecklistLine[]
  enteredSections EnteredSection[]
  signSteps   SignStep[]   // C8.1
  signedScans SignedScan[] // C8.1
  findings    ReviewFinding[] // C7.5
  personLinks PersonLink[] // C6.16
  filingRecords FilingRecord[] // C8.2
  tasks         CaseTask[]     // C8.2
  filingChanges FilingChange[] // C6.13
  feeReceipts   FeeReceiptFile[] // C8.2 B149
  documentReviews DocumentReview[] // C6.5
  readValues      ReadValue[]      // C6.5
  answerChecks    AnswerCheck[]    // C6.5
  stages          CaseStage[] // C6.17
  formAdditions   FilingFormAddition[] // C7.8
  reviewRounds      ReviewRound[]       // C8.3
  reviewRoundRows   ReviewRoundFiling[] // C8.3
  reviewRoundForms  ReviewRoundForm[]   // C8.3
  reviewChecks      ReviewCheck[]       // C8.3

  /// C6.11 break M2, M3: a reference and an idempotency key are unique within a firm, so one firm neither collides with
  /// nor learns of another firm's cases.
  @@unique([workspaceId, firmKey, idempotencyKey])
  @@unique([workspaceId, firmKey, reference])
  @@unique([workspaceId, firmKey, caseNumber])
  @@index([workspaceId, createdAt])
  @@map("runtime_case")
}

/// A24-1 (P-492, CS-7): a firm's next case number for one year (the year in the firm's zone, America/Toronto). Only
/// runtime_next_case_number() writes it, inside the opening transaction: two openings at once wait on the row and never
/// share a number, and a refused opening rolls its increment back (no gap). A demo reset clears it with the cases.
model FirmCaseCounter {
  workspaceId String @map("workspace_id") @db.Uuid
  firmKey     String @map("firm_key")
  year        Int
  nextValue   Int    @map("next_value")

  @@id([workspaceId, firmKey, year])
  @@map("firm_case_counter")
}

/// C6.11 (BR-20, SI-15): who works a case, shaped like the team's AG-07 CaseTeamMember (LEAD_REPRESENTATIVE · OFFICER).
/// One row per assignment; a reassignment ends the row (ended_at, by, reason) and inserts the next, so the history stays.
/// The database refuses two current representatives of record on one case and the same person twice in one role
/// (partial unique indexes in the migration 20261101130000_c611_case_team). userId names a seeded Sample user.
model CaseTeamMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  caseId      String    @map("case_id") @db.Uuid
  userId      String    @map("user_id")
  /// LEAD_REPRESENTATIVE (the representative of record, on IMM 5476) · OFFICER (a case officer)
  role        String
  assignedBy  String    @map("assigned_by")
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  endedBy     String?   @map("ended_by")
  endReason   String?   @map("end_reason")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, assignedAt])
  @@map("case_team_member")
}

/// C7.3 (r5c §6, P-62 §6): "Entered in the portal" for one section of an Online form item's answer sheet: who ticked it,
/// when, and the answers it showed, frozen in an answer snapshot. One current tick per item and section; a fact changed
/// after it marks the section out of date (P-65). Ticking an out-of-date section again freezes a new snapshot and marks the
/// old tick superseded (kept as history); the frozen answers never change.
model EnteredSection {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  /// The PDF twin's section group (contracts/pdf-sections.json), e.g. SectionA, until the portal's own screens (W6).
  sectionKey  String   @map("section_key")
  snapshotId  String   @unique @map("snapshot_id") @db.Uuid
  enteredBy   String   @map("entered_by")
  enteredAt   DateTime @default(now()) @map("entered_at") @db.Timestamptz
  /// Set when the section is ticked again after it went out of date (the next tick is the current one).
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz

  case     Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item     FilingItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  snapshot AnswerSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// One current tick per item and section: a partial unique index in the migration (WHERE superseded_at IS NULL).
  @@index([itemId, sectionKey])
  @@index([caseId])
  @@map("entered_section")
}

/// The release a case works from (team PackWorkPin, pinned per case and combination here). Insert-only.
model PackWorkPin {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  combinationId   String   @map("combination_id") @db.Uuid
  partyId         String   @map("party_id") @db.Uuid
  packVersionId   String?  @map("pack_version_id") @db.Uuid
  configReleaseId String   @map("config_release_id") @db.Uuid
  contentHash     String   @map("content_hash") @db.VarChar(64)
  purpose         String   @default("SQR_ADVANCE")
  revision        Int      @default(1)
  actorId         String   @map("actor_id")
  pinnedAt        DateTime @default(now()) @map("pinned_at") @db.Timestamptz
  /// C9.5: why the case moved to this release (revision 2 on; the first pin has none). Written once (insert only).
  reason          String?

  case    Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// A pinned release cannot be deleted (released means frozen; STANDARDS §3.7).
  release ConfigRelease @relation(fields: [configReleaseId], references: [id], onDelete: Restrict)

  /// C9.5: a move to a newer release is a new revision (insert only; trigger runtime_pin_chain: previous + 1, a higher
  /// release version of the same combination, a reason). The case reads its newest revision.
  @@unique([caseId, combinationId, revision])
  @@map("pack_work_pin")
}

/// C6.17 (B139; concept BR-2; founder P-412 F13 (a)): a route, an ordered list of existing combinations kept as data, with
/// no new tree level. stages: [{key, staff_name, client_name, combination_key, key_details[{field, label, type,
/// same_every_stage?}], next, deadline?{label, from, add_days, ...}, same_documents?}]; loaded only with 2+ stages, every
/// combination present and used once (engine/runtime/stages.ts routeProblems). Sample until the immigration expert
/// gives real routes (scaffolding: samples/routes.json).
model Route {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  key         String
  label       String
  /// SAMPLE · CITED
  basis       String   @default("SAMPLE")
  stages      Json
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([workspaceId, key])
  @@map("route")
}

/// C6.17 (B139; concept §2, BR-1..BR-10): one stage of a case, frozen from its route at opening (a case on no route has
/// one stage). state DONE_BEFORE (made before the firm took the case; key details only) · NOT_RECORDED (an earlier stage
/// left unticked) · CURRENT (one per case, partial unique case_stage_one_current; its combination is the case's, a
/// deferred trigger) · ENDED_NEXT_STARTED · NOT_STARTED; forward only (trigger). A worked stage has its own application
/// subject (challenge B3). key_details: {field: {value, by, at}} on the stage record (SA-1B-212 §7; P-412 F13 (c)).
model CaseStage {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  caseId               String    @map("case_id") @db.Uuid
  firmKey              String    @map("firm_key")
  ord                  Int
  stageKey             String    @map("stage_key")
  staffName            String    @map("staff_name")
  clientName           String    @map("client_name")
  combinationId        String    @map("combination_id") @db.Uuid
  applicationSubjectId String?   @unique @map("application_subject_id") @db.Uuid
  state                String
  startedFrom          String?   @map("started_from")
  keyDetails           Json      @default("{}") @map("key_details")
  /// The stage as frozen from its route at opening: {key_details[], deadline?, same_documents[]} (Sample data).
  spec                 Json      @default("{}")
  routeKey             String?   @map("route_key")
  /// The stage version a "Start next stage" request names (409 when it moved).
  version              Int       @default(1)
  startedBy            String?   @map("started_by")
  startedAt            DateTime? @map("started_at") @db.Timestamptz
  endedBy              String?   @map("ended_by")
  endedAt              DateTime? @map("ended_at") @db.Timestamptz
  recordedBy           String?   @map("recorded_by")
  recordedAt           DateTime? @map("recorded_at") @db.Timestamptz
  /// Why the next stage was started while a filing had no record (P-237); never in an audit line.
  reason               String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  case        Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  combination Combination       @relation(fields: [combinationId], references: [id], onDelete: Restrict)
  application AnswerSubject?    @relation(fields: [applicationSubjectId], references: [id], onDelete: NoAction)
  filings     Filing[]
  groups      SubmissionGroup[]
  lines       ChecklistLine[]
  findings    ReviewFinding[]
  tasks       CaseTask[]

  @@unique([caseId, ord])
  @@unique([caseId, combinationId])
  @@index([workspaceId, caseId])
  @@map("case_stage")
}

/// A person (team Party; per workspace here, per firm there).
model Party {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  kind        String   @default("PERSON")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile  PartyProfile?
  from     PartyRelationship[] @relation("PartyRelFrom")
  to       PartyRelationship[] @relation("PartyRelTo")
  subjects AnswerSubject[]

  @@index([workspaceId])
  @@map("party")
}

model PartyProfile {
  id                  String  @id @default(uuid()) @db.Uuid
  workspaceId         String  @map("workspace_id") @db.Uuid
  partyId             String  @unique @map("party_id") @db.Uuid
  displayName         String  @map("display_name")
  localePreference    String? @map("locale_preference")
  contactChannelsJson Json    @default("{}") @map("contact_channels_json")

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_profile")
}

/// Principal → spouse or partner, principal → child (open vocabulary, as the team's). Self-edge refused in SQL.
model PartyRelationship {
  id               String  @id @default(uuid()) @db.Uuid
  workspaceId      String  @map("workspace_id") @db.Uuid
  fromPartyId      String  @map("from_party_id") @db.Uuid
  toPartyId        String  @map("to_party_id") @db.Uuid
  relationshipType String  @map("relationship_type")
  role             String?

  fromParty Party @relation("PartyRelFrom", fields: [fromPartyId], references: [id], onDelete: Cascade)
  toParty   Party @relation("PartyRelTo", fields: [toPartyId], references: [id], onDelete: Cascade)

  @@index([fromPartyId])
  @@map("party_relationship")
}

/// Whom an answer is about: a person on the case, or the case itself (subjectKind "case", party = the principal), or a
/// relative a form describes (subjectKind "parent_1", "parent_2", "sibling"; B128, B155), at most one per party and
/// relation: a partial unique index in SQL (migration 20261108050000_b157_one_relative_subject; B157).
model AnswerSubject {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  partyId     String @map("party_id") @db.Uuid
  subjectKind String @map("subject_kind")
  label       String

  party        Party                   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  participant  CaseParticipant?
  answers      ClientCanonicalAnswer[]
  records      ClientFactRecord[]
  groupAnswers ClientGroupAnswer[]
  checklistLines ChecklistLine[]
  documents    CaseDocument[]
  /// C6.17 (B3): the stage whose application this subject is (one application subject per worked stage).
  stage          CaseStage?
  personLinks  PersonLink[] // C6.16

  @@map("answer_subject")
}

/// Who is on the case, in the combination's roles (the team has no case membership; D-2).
model CaseParticipant {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  caseId      String  @map("case_id") @db.Uuid
  subjectId   String  @unique @map("subject_id") @db.Uuid
  /// principal · spouse_or_partner · child · case. A24-1 (P-492, CS-1): exactly one principal per case, the case's client
  /// person, checked by the database at commit (case_participant_one_principal, trg_case_participant_principal).
  role        String
  /// travelling with the application (a combination participant that "applies")
  applies     Boolean @default(true)
  order       Int
  /// The add-person request's key and fingerprint (QA-28): the same key again returns this person, never a second one.
  idempotencyKey         String? @map("idempotency_key")
  idempotencyFingerprint String? @map("idempotency_fingerprint") @db.VarChar(64)
  /// C6.16 (B138; AG-7-107 Q71 option B): the team's "Keep private from the principal", stored once per adult. On at the
  /// adult's first right code on their own link, or by staff with a reason; it stays on (a trigger refuses true to false).
  keepPrivate Boolean   @default(false) @map("keep_private")
  privateAt   DateTime? @map("private_at") @db.Timestamptz
  privateBy   String?   @map("private_by")
  privateWhy  String?   @map("private_why")

  case    Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  subject AnswerSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([caseId, order])
  @@unique([caseId, idempotencyKey])
  @@map("case_participant")
}

/// One row of a repeating group (team ClientFactRecord; groupKey = the questionnaire section holding the group, D-5).
/// Removing a row inserts a tombstone version; nothing is deleted.
model ClientFactRecord {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  groupKey       String   @map("group_key")
  /// Stable row identity across versions (the first version's id).
  rowKey         String   @map("row_key") @db.Uuid
  order          Int
  tombstone      Boolean  @default(false)
  supersededById String?  @map("superseded_by_id") @db.Uuid
  sourceJson     Json     @map("source_json")
  effectiveAt    DateTime @default(now()) @map("effective_at") @db.Timestamptz

  subject      AnswerSubject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  supersededBy ClientFactRecord?       @relation("ClientFactRecordChain", fields: [supersededById], references: [id], onDelete: Cascade)
  supersedes   ClientFactRecord[]      @relation("ClientFactRecordChain")

  @@index([subjectId, groupKey])
  @@map("client_fact_record")
}

/// "None apply" for one repeating group of one subject (Lead, R1d answer to break M3, P-71/P-72): a fact like any other,
/// answered, confirmed and changed like an answer. Append-only; noneApply false records "entries apply" (the change back).
model ClientGroupAnswer {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  groupKey       String    @map("group_key")
  noneApply      Boolean   @map("none_apply")
  status         String
  supersededById String?   @map("superseded_by_id") @db.Uuid
  sourceJson     Json      @map("source_json")
  verifiedBy     String?   @map("verified_by")
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz
  effectiveAt    DateTime  @default(now()) @map("effective_at") @db.Timestamptz

  subject      AnswerSubject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  supersededBy ClientGroupAnswer?  @relation("ClientGroupAnswerChain", fields: [supersededById], references: [id], onDelete: Cascade)
  supersedes   ClientGroupAnswer[] @relation("ClientGroupAnswerChain")

  @@index([subjectId, groupKey])
  @@map("client_group_answer")
}

/// One answer about one subject for one shared field (and one row of a group). Append-only: a change inserts a new row
/// and stamps the old one superseded, in one transaction. DECLARED = typed; VERIFIED = confirmed by the officer.
model ClientCanonicalAnswer {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  partyId           String    @map("party_id") @db.Uuid
  subjectId         String    @map("subject_id") @db.Uuid
  canonicalFieldId  String    @map("canonical_field_id") @db.Uuid
  canonicalFieldKey String    @map("canonical_field_key")
  /// The repeating-group row (ClientFactRecord.rowKey) this answer belongs to; null for a single answer.
  rowKey            String?   @map("row_key") @db.Uuid
  valueJson         Json      @map("value_json")
  status            String
  effectiveAt       DateTime  @default(now()) @map("effective_at") @db.Timestamptz
  supersededById    String?   @map("superseded_by_id") @db.Uuid
  /// { channel: questionnaire | agent_view | confirm_section, actor, at }
  sourceJson        Json      @map("source_json")
  verifiedBy        String?   @map("verified_by")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz

  subject        AnswerSubject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  canonicalField CanonicalField          @relation(fields: [canonicalFieldId], references: [id], onDelete: Restrict)
  supersededBy   ClientCanonicalAnswer?  @relation("ClientCanonicalAnswerChain", fields: [supersededById], references: [id], onDelete: Cascade)
  supersedes     ClientCanonicalAnswer[] @relation("ClientCanonicalAnswerChain")

  @@index([subjectId, canonicalFieldKey])
  @@map("client_canonical_answer")
}

/// The confirmed facts one generated copy read (team AnswerSnapshot): the values each form field of one form took for
/// one person, frozen, and their hash. A later answer never changes it; "out of date" compares it with today's facts.
model AnswerSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  formNumber  String   @map("form_number")
  inputHash   String   @map("input_hash") @db.VarChar(64)
  /// [{ fact, about, row, value }] the confirmed facts read, in form-field order
  factsJson   Json     @map("facts_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  case    Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  form    FormInstance?
  entered EnteredSection?
  reviewFrozen ReviewRoundForm[] @relation("ReviewFrozen") // C8.3
  reviewStamps ReviewRoundForm[] @relation("ReviewStamp")  // C8.3

  @@map("answer_snapshot")
}

/// One generated copy of one form for one person on a case (team FormInstance), never overwritten (P-65): a new copy is a
/// new row. Status QUEUED → RUNNING → GENERATED | FAILED (the generation job); a GENERATED copy may be locked once
/// ("validated copy uploaded back" or "filed"), after which nothing about it changes (database trigger).
model FormInstance {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  caseId          String    @map("case_id") @db.Uuid
  subjectId       String    @map("subject_id") @db.Uuid
  formNumber      String    @map("form_number")
  configReleaseId String    @map("config_release_id") @db.Uuid
  snapshotId      String    @unique @map("snapshot_id") @db.Uuid
  status          String    @default("QUEUED")
  path            String?
  sha256          String?   @db.VarChar(64)
  /// The filler's report and the per-form-field results (written, by hand, by a person, not written and why)
  resultJson      Json?     @map("result_json")
  error           String?
  lockedKind      String?   @map("locked_kind")
  lockedAt        DateTime? @map("locked_at") @db.Timestamptz
  lockedBy        String?   @map("locked_by")
  idempotencyKey  String?   @map("idempotency_key")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz

  case      Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  snapshot  AnswerSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  validated ValidatedCopy[]
  signSteps SignStep[] // C8.1: the print step names the copy printed

  @@unique([caseId, idempotencyKey])
  @@index([caseId, formNumber, subjectId, createdAt])
  @@map("form_instance")
}

/// W1-10 slice 1 C-9/C-10 (P-144, P-171 (1)): the filled PDF after the person's Validate, read back into the case. Its
/// file checksum and the fingerprint of the form's facts when it was read back; a later change to those facts makes it
/// "Out of date: validate again". Insert-only: kept as history, never deleted.
model ValidatedCopy {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  formInstanceId String   @map("form_instance_id") @db.Uuid
  path           String
  sha256         String   @db.VarChar(64)
  factsHash      String   @map("facts_hash") @db.VarChar(64)
  /// What the read-back found: the form fields compared, those that match the copy, and any that differ (by question).
  readBack       Json     @map("read_back")
  readBy         String   @map("read_by")
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz

  copy FormInstance @relation(fields: [formInstanceId], references: [id], onDelete: Cascade)

  @@index([formInstanceId, readAt])
  @@map("validated_copy")
}

// ─── F2 browser extension (forms lane, P-90; plan §4) ────────────────────────────────────────────────────────────

/// A one-time pairing code shown in the signed-in Studio (Lead decision Q1). Only its sha256 is kept; one use, 5 min (Sample).
model ExtensionPairing {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  person      String
  modes       String[]
  codeHash    String    @unique @map("code_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  /// The code's first three characters, which find it; a wrong code with them counts against it (review-2 Minor 1).
  selector    String?   @db.VarChar(3)
  /// Wrong codes tried against this one, kept in the database (never per address in memory); the fifth voids it.
  wrongTries  Int       @default(0) @map("wrong_tries")
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([person, createdAt])
  @@index([selector])
  @@map("extension_pairing")
}

/// One try to exchange a pairing code, kept a few minutes: the throttle per address and for the whole server (review-3
/// Major 2). Holds the client's address and the time only; never the code.
model ExtensionCodeTry {
  id      BigInt   @id @default(autoincrement())
  address String   @db.VarChar(64)
  at      DateTime @default(now()) @db.Timestamptz

  @@index([at, address])
  @@map("extension_code_try")
}

/// The extension's session: an opaque token, kept only as its sha256, bound to one person, firm, modes and extension
/// id; revocable; 8 h (Sample). The token itself lives in the extension's session storage (memory) only.
model ExtensionSession {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  person      String
  modes       String[]
  extensionId String    @map("extension_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  pairingId   String    @unique @map("pairing_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([person, createdAt])
  @@map("extension_session")
}

/// "Re-capture needed" (BR-7, XT-6): opened when a live screen differs from the approved twin's screen at fill, or a
/// screen is not in the twin. One open task per (online version, screen, kind) (partial unique index in SQL). The
/// differences name input ids, the kind of change, option codes and the twin's approved label: never live text (M5).
model RecaptureTask {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  formEditionId String    @map("form_edition_id") @db.Uuid
  screenPage    String    @map("screen_page")
  screenTitle   String    @map("screen_title")
  kind          String
  status        String    @default("OPEN")
  differences   Json      @default("[]")
  affected      Json      @default("{}")
  times         Int       @default(1)
  openedBy      String    @map("opened_by")
  openedAt      DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  closedBy      String?   @map("closed_by") @db.Uuid
  closedAt      DateTime? @map("closed_at") @db.Timestamptz

  edition FormEdition @relation(fields: [formEditionId], references: [id], onDelete: Cascade)

  @@index([formEditionId, status])
  @@map("recapture_task")
}

/// W1-15 slice 1 (P-130, challenge M1): what a person set for one fact of one person role on a combination, over the
/// rules' default (engine/sources.ts): where the answer comes from, and the Pre-qualification tick. Nothing is stored
/// for a fact left as the rules say. Versioned like document requirements (draft, published at release).
model FactSource {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  combinationId     String           @map("combination_id") @db.Uuid
  /// `${role}|${fact}`
  lineageKey        String           @map("lineage_key")
  role              String
  canonicalFieldKey String           @map("canonical_field_key")
  /// DOCUMENT · CLIENT · AGENT; null keeps the rules' source (only the tick is set)
  source            String?
  documentTypeKey   String?          @map("document_type_key")
  prequalification  Boolean          @default(false)
  reason            String?
  version           Int
  status            DefinitionStatus
  supersedesId      String?          @map("supersedes_id") @db.Uuid
  origin            Origin
  updatedBy         String           @map("updated_by")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  /// One bulk change (slice 2): its rows share this id, so one Undo takes them back together
  batchId           String?          @map("batch_id") @db.Uuid
  /// P-155(3): why the case officer enters a fact that is not a case officer's own (required for that choice)
  sourceReason      String?          @map("source_reason")

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@unique([combinationId, lineageKey, version])
  @@index([combinationId, batchId])
  @@map("fact_source")
}

/// C6.12 /prepare (M3-B2; r5c BR-1, BR-16, contract §6): a case's submission groups, filings, their applicants and the
/// items filed with them, stored the first time /prepare derives them so each keeps its id (a split, a channel change
/// and the filing record attach to it). Derived from the case's people and release; nobody creates one by hand.
model SubmissionGroup {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  /// FAMILY (one submission at the same time and place) · SEPARATE (a filing split out, with its reason)
  kind        String
  /// C6.12 split (BR-16): why a SEPARATE group was split out (required for SEPARATE, never in an audit line).
  reason      String?
  /// Who made the group (the read that first derived it, or the officer who split).
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// B152 (FQ-7, C6.12, C8.2): the group's fee lines and totals as GET …/prepare showed them when the submission was
  /// recorded, written once by "Record the submission"; a recorded group is read from it, so a birthday, a corrected date
  /// of birth or a fee-table change later never changes what was filed. Null until recorded.
  recordedFees Json?   @map("recorded_fees")

  /// C6.17: the stage the group belongs to (one FAMILY group per case and stage: submission_group_one_family, in SQL).
  stageId String @map("stage_id") @db.Uuid

  case    Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage   CaseStage      @relation(fields: [stageId], references: [id], onDelete: NoAction)
  filings Filing[]
  records FilingRecord[] // C8.2

  @@index([caseId])
  @@index([stageId])
  @@map("submission_group")
}

/// One application to IRCC by one person (files_own) on a case; inactive while the person is not applying, so the
/// same person keeps the same filing when they apply again.
model Filing {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  caseId            String   @map("case_id") @db.Uuid
  submissionGroupId String   @map("submission_group_id") @db.Uuid
  /// The answer subject who files it (the filing's principal applicant).
  subjectId         String   @map("subject_id") @db.Uuid
  combinationKey    String   @map("combination_key")
  mode              String
  active            Boolean  @default(true)
  status            String   @default("NOT_STARTED")
  applicationNumber String?  @map("application_number")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// C8.2: the record of the submission (one, BR-15), each person's UCI, the number's corrections, its tasks.
  record            FilingRecord?
  personRecords     FilingPersonRecord[]
  corrections       FilingRecordCorrection[]
  tasks             CaseTask[]

  /// C6.17: the stage (one combination's application) this filing belongs to.
  stageId    String            @map("stage_id") @db.Uuid
  case       Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage      CaseStage         @relation(fields: [stageId], references: [id], onDelete: NoAction)
  group      SubmissionGroup   @relation(fields: [submissionGroupId], references: [id], onDelete: Restrict)
  applicants FilingApplicant[]
  items      FilingItem[]
  findings   ReviewFinding[] // C7.5
  additions  FilingFormAddition[] // C7.8
  reviews    FilingReview[]  // C7.6
  passes     ReadinessPass[] // C7.6
  reviewRounds ReviewRoundFiling[] // C8.3
  reviewForms  ReviewRoundForm[]   // C8.3

  @@unique([caseId, stageId, subjectId])
  @@index([stageId])
  @@map("filing")
}

model FilingApplicant {
  id        String @id @default(uuid()) @db.Uuid
  filingId  String @map("filing_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  role      String
  /// applying · declared_only (C11.12: named on the principal's application, not accompanying)
  mode      String

  filing Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@unique([filingId, subjectId])
  @@map("filing_applicant")
}

/// A form filed with a filing, for one person: its channel starts as the combination line's and may be changed on the
/// case within what IRCC accepts (C11.6). Inactive while the form does not apply, so it keeps its id and channel.
model FilingItem {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  caseId        String         @map("case_id") @db.Uuid
  filingId      String         @map("filing_id") @db.Uuid
  /// form, document (the checklist's, C6.4) or step (an IRCC step such as biometrics)
  kind          String
  /// The form number, document type or step key (C11.6, C7.7).
  itemKey       String         @map("item_key")
  /// Kept from #325 (C6.12 M3-B2): read by no code now; dropped in a later contract migration.
  formKey       String?        @map("form_key")
  subjectId     String         @map("subject_id") @db.Uuid
  /// C11.6: the channel the case officer chose inside what IRCC accepts; null = the combination line's channel.
  channel       FilingChannel?
  channelReason String?        @map("channel_reason")
  channelBy     String?        @map("channel_by")
  channelAt     DateTime?      @map("channel_at") @db.Timestamptz
  /// false while the item does not apply (it keeps its id and channel when it applies again).
  active        Boolean        @default(true)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  case    Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filing  Filing           @relation(fields: [filingId], references: [id], onDelete: Cascade)
  entered EnteredSection[]
  signSteps   SignStep[]   // C8.1
  signedScans SignedScan[] // C8.1
  tasks       CaseTask[]   // C8.2
  reviewForms ReviewRoundForm[] // C8.3

  @@unique([filingId, kind, itemKey, subjectId])
  @@index([caseId])
  @@map("filing_item")
}

/// C11.10 (P-115: Cards / List remembered per person): a person's own view choices, kept on the server so they follow the
/// person to any browser. Keyed by the person only (no workspace): a demo Reset makes a new workspace, and a person's own
/// view choice is not configuration, so it stays. Values are checked against a fixed list per key (contracts/session.ts).
model PersonPreference {
  actor     String
  key       String
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([actor, key])
  @@map("person_preference")
}

/// C6.4 storage slice (M3-C; SI-14): one row per filing person x document on a case, written when the derived checklist
/// says the person needs it; it keeps its id and state when the answers take the line away and bring it back.
/// state: not_requested · requested · received · being_checked · approved · rejected · not_applicable (a check in SQL).
model ChecklistLine {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  caseId       String    @map("case_id") @db.Uuid
  subjectId    String    @map("subject_id") @db.Uuid
  /// The document type key (one line per person and document type, as the derived checklist merges them).
  documentType String    @map("document_type")
  /// The requirement lineage the line was first written for (the derived line's lineage).
  lineage      String
  state        String    @default("not_requested")
  /// Why the line is Not applicable or Waived (required for those states, a check in SQL).
  stateReason  String?   @map("state_reason")
  stateBy      String?   @map("state_by")
  stateAt      DateTime? @map("state_at") @db.Timestamptz
  /// C6.14 (SA-1B-214 rule 2): the officer's choice of providers (answer_subject ids) on a shared line; empty = the
  /// document type's defaults. A choice carries a reason (a check in SQL).
  providers       String[]  @default([]) @db.Uuid
  providersReason String?   @map("providers_reason")
  providersBy     String?   @map("providers_by")
  providersAt     DateTime? @map("providers_at") @db.Timestamptz
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  /// C6.17: the stage whose checklist this line is (a new stage's lines start fresh, BR-6).
  stageId   String         @map("stage_id") @db.Uuid
  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage     CaseStage      @relation(fields: [stageId], references: [id], onDelete: NoAction)
  subject   AnswerSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  documents CaseDocument[]

  @@unique([caseId, stageId, subjectId, documentType])
  @@index([stageId])
  @@map("checklist_line")
}

/// C6.4 storage slice: an uploaded document, owned by the person (not the case). One current file per person and
/// document type (partial unique index case_document_one_current, in SQL); a new upload keeps the old one as history.
model CaseDocument {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  subjectId       String    @map("subject_id") @db.Uuid
  documentType    String    @map("document_type")
  /// The checklist line it was uploaded on (kept for history; null if that line is gone).
  checklistLineId String?   @map("checklist_line_id") @db.Uuid
  fileName        String    @map("file_name")
  /// application/pdf · image/jpeg · image/png (a check in SQL), from the file's own bytes.
  mediaType       String    @map("media_type")
  sizeBytes       Int       @map("size_bytes")
  sha256          String    @db.VarChar(64)
  /// Relative to the working files of the workspace (var/workspaces/<ws>/).
  path            String
  current         Boolean   @default(true)
  uploadedBy      String    @map("uploaded_by")
  uploadedAt      DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz

  subject AnswerSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  line    ChecklistLine? @relation(fields: [checklistLineId], references: [id], onDelete: SetNull)
  review  DocumentReview? // C6.5: its one read

  @@index([subjectId, documentType])
  @@map("case_document")
}

/// C6.9 (M3-D, SI-1; team AG-03 §7 Assessment): one eligibility run for one person on a case, frozen. result_json holds
/// AG-03's whole envelope (its AssessmentProgramResult list inside, not as rows). A database trigger refuses any UPDATE
/// (migration 20261102120000_c69_eligibility); review and override are rows of their own. Written from part 2.
model Assessment {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  configReleaseId String   @map("config_release_id") @db.Uuid
  resultJson      Json     @map("result_json")
  /// MANUAL (the first run for a person), then RERUN
  runType         String   @map("run_type")
  reason          String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  case      Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  overrides AssessmentOverride[]
  review    AssessmentReview?

  @@index([caseId, subjectId, createdAt])
  @@map("assessment")
}

/// C6.9 (BR-15, AG-03 AssessmentOverride): an officer's label and reason beside an engine result; the result never changes.
model AssessmentOverride {
  id           String   @id @default(uuid()) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  programKey   String   @map("program_key")
  fromOutcome  String   @map("from_outcome")
  label        String
  reason       String
  /// { by, duty, licence, outOfDate }
  stamp        Json
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_override")
}

/// C6.9 (BR-16, AG-3-34): "Reviewed by" / "Seen by" on a run, once per run.
model AssessmentReview {
  assessmentId String   @id @map("assessment_id") @db.Uuid
  reviewedBy   String   @map("reviewed_by")
  reviewedAt   DateTime @default(now()) @map("reviewed_at") @db.Timestamptz
  note         String?
  /// { duty, licence, stamp: "Reviewed"|"Seen", outOfDate }
  stamp        Json

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_review")
}

// ─── Answer-key tests (G4, C5.7; P-240; SA-01B v2.1 SA-1B-296 field 7, SA-1B-181, SA-1B-199) ──────────────────────
// Made-up families only (never a client: no case, no firm), shared by every combination of the workspace; a key holds
// what one item (a form's field map or the combination's eligibility rules) should give for one family; a run is
// frozen with the fingerprints of what it read (engine/answer-keys.ts). Migration 20261102160000_g4_answer_keys.

/// The team's TestFamily (SA-1B-296 f.7): { key, label, reference_date, people[{id, role, label, applies}], facts[{about,
/// fact, row, value}], none_apply[{about, group}] } (engine/answer-keys.ts Family; the team's persons and answers).
/// Classification: made-up test data, no personal data (P-249): never copied from a case; Sample until signed.
model TestFamily {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  familyKey     String   @map("family_key")
  label         String
  referenceDate String   @map("reference_date")
  people        Json
  facts         Json
  noneApply     Json     @default("[]") @map("none_apply")
  version       Int      @default(1)
  updatedBy     String   @map("updated_by")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  keys AnswerKey[]

  @@unique([workspaceId, familyKey])
  @@map("test_family")
}

/// The team's AnswerKey: one per family, combination and item (item_kind field_map with item_ref the form number, or
/// rule_set with item_ref "eligibility"). state DRAFT | SIGNED (a check in SQL); a change to a signed key needs a reason
/// and returns it to DRAFT. edition: the form edition a field-map key was written for (one edition proves nothing about
/// another, SA-1B-296 rule 5).
model AnswerKey {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  combinationId String    @map("combination_id") @db.Uuid
  itemKind      String    @map("item_kind")
  itemRef       String    @map("item_ref")
  expected      Json
  state         String    @default("DRAFT")
  version       Int       @default(1)
  signedByUserId String?  @map("signed_by_user_id")
  signedAt      DateTime? @map("signed_at") @db.Timestamptz
  changeReason  String?   @map("change_reason")
  updatedBy     String    @map("updated_by")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  family      TestFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  combination Combination     @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  runs        AnswerKeyRun[]

  @@unique([familyId, combinationId, itemKind, itemRef])
  @@index([combinationId])
  @@map("answer_key")
}

/// The team's AnswerKeyRun: result PASSED | FAILED (a check in SQL), every line (expected, got, pass), and what it read:
/// the key version, the item's fingerprint and the whole snapshot's (a later change makes it "Not run", BR-5).
model AnswerKeyRun {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  keyId             String   @map("key_id") @db.Uuid
  keyVersion        Int      @map("key_version")
  itemFingerprint   String   @map("item_fingerprint") @db.VarChar(64)
  inputsFingerprint String   @map("inputs_fingerprint") @db.VarChar(64)
  result            String
  lines             Json
  passed            Int
  failed            Int
  ranBy             String   @map("ran_by")
  ranAt             DateTime @default(now()) @map("ran_at") @db.Timestamptz

  key AnswerKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@index([keyId, ranAt])
  @@map("answer_key_run")
}

/// G-CORE (P-253, concept screens/G-CORE-guarded-change/concept.md v2): one change set per guarded change to a shared
/// library item, by a person or the AI. It records the items, what the fixed rules check found, the review tier, the
/// preview's fingerprint and who made it; the second-person review stays on library_change / field_merge (linked here).
/// A direct rename keeps its before-image for its roll-back. Rows are written by the change's own transaction (B2, B3);
/// B1 adds the table and the check (which writes nothing).
model ChangeSet {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  /// person · ai · ai_edited (an AI item a person edited before accepting) · ai_draft (held, L-SA11)
  madeBy        String   @map("made_by")
  actor         String
  /// The change set's items (contracts/change-set.ts ChangeItem[]).
  items         Json
  /// What the rules check found (CheckProblem[]); empty when it passed.
  problems      Json     @default("[]")
  /// direct · second_person
  tier          String
  expertAtRelease Boolean @default(false) @map("expert_at_release")
  fingerprint   String   @db.VarChar(64)
  /// applied (direct) · waiting (a second person) · rolled_back · undone (a refused change writes no row)
  status        String
  libraryChangeId String? @map("library_change_id") @db.Uuid
  fieldMergeId  String?  @map("field_merge_id") @db.Uuid
  proposalBatchId String? @map("proposal_batch_id") @db.Uuid
  /// A direct rename's before-image (BR-6): what its roll-back puts back.
  before        Json?
  rolledBackBy  String?  @map("rolled_back_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([proposalBatchId])
  @@map("change_set")
}

/// G1 (C5.4; P-240; concept screens/G1-source-register, tech lead's approval on #558): the source of one published
/// number in one item. Either an official citation (citationUrl + citationQuote + citationDate; citationPage optional)
/// or "None published – set by ExpatReady" with its reason; never both (a check in SQL). itemKey carries the
/// combination; valuePath is the address by meaning "<field>|<op>|<k>" (or "min_age" / "months"); value is the number
/// the entry was written for (canonical text). sample: passes only in the demo workspace as a Demo release. version:
/// a save with an old version gets 409. No relation to the item (items are versioned rows).
model SourceEntry {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  itemKind            String    @map("item_kind")
  itemKey             String    @map("item_key")
  valuePath           String    @map("value_path")
  value               String
  citationUrl         String?   @map("citation_url")
  citationPage        String?   @map("citation_page")
  citationQuote       String?   @map("citation_quote")
  citationDate        DateTime? @map("citation_date") @db.Date
  nonePublished       Boolean   @default(false) @map("none_published")
  nonePublishedReason String?   @map("none_published_reason")
  sample              Boolean   @default(false)
  version             Int       @default(1)
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy           String    @map("updated_by")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, itemKind, itemKey, valuePath])
  @@map("source_entry")
}

/// C8.1 (M3-F; M3-CONTRACT C8.1): one step done on a form item signed by hand and scanned (print · signed · scan_received
/// · uploaded_to_ircc), with who and when; "print" names the generated copy printed. One current row per item and step
/// (partial unique index in the migration); superseded_at is for C9.2 (steps re-opened after a fact changes).
model SignStep {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  caseId       String    @map("case_id") @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  key          String
  copyId       String?   @map("copy_id") @db.Uuid
  doneBy       String    @map("done_by")
  doneAt       DateTime  @default(now()) @map("done_at") @db.Timestamptz
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz

  case Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item FilingItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  copy FormInstance? @relation(fields: [copyId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@map("sign_step")
}

/// C8.1: a signed scan of a form item; append-only (a trigger refuses UPDATE). The file is in var/, named by the row id,
/// checked by its sha256 before it is read (as C6.4's case_document; stand-in SI-14).
model SignedScan {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  fileName    String   @map("file_name")
  mediaType   String   @map("media_type")
  sizeBytes   Int      @map("size_bytes")
  sha256      String   @db.VarChar(64)
  path        String
  uploadedBy  String   @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  case Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item FilingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("signed_scan")
}

/// C8.2 (BR-15, BR-21, P-155): what one filing was submitted as, written once when its group is recorded. Prepared by is
/// the case officer who recorded it; Reviewed by the representative of record. `filedFacts` keeps the facts each form
/// was filed with, so a later change reads "Filed with an earlier value" (BR-12).
model FilingRecord {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  caseId            String   @map("case_id") @db.Uuid
  filingId          String   @unique @map("filing_id") @db.Uuid
  submissionGroupId String   @map("submission_group_id") @db.Uuid
  portal            String?
  ourReference      String   @map("our_reference")
  submittedOn       DateTime @map("submitted_on") @db.Date
  applicationNumber String   @map("application_number")
  feeReceipt        String?  @map("fee_receipt")
  preparedBy        String   @map("prepared_by")
  reviewedBy        String?  @map("reviewed_by")
  recordedBy        String   @map("recorded_by")
  recordedAt        DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  filedFacts        Json     @map("filed_facts")

  case   Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filing Filing          @relation(fields: [filingId], references: [id], onDelete: Cascade)
  group  SubmissionGroup @relation(fields: [submissionGroupId], references: [id], onDelete: Restrict)
  feeReceipts FeeReceiptFile[] // B149

  @@index([caseId])
  @@map("filing_record")
}

/// C8.2 B149 (P-408; board agent-view frame 7): the fee receipt's evidence, IRCC's "Transaction Approved" page, uploaded
/// on a recorded filing (the FK to filing_record.filing_id: never before it is recorded). Append-only (a trigger refuses
/// any UPDATE): a wrong file is followed by a new upload, the newest is the receipt, earlier ones stay in the history. The
/// file is in the working files (var/), named by the row id, checked by its sha256, as C8.1's signed_scan.
model FeeReceiptFile {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  filingId    String   @map("filing_id") @db.Uuid
  fileName    String   @map("file_name")
  mediaType   String   @map("media_type")
  sizeBytes   Int      @map("size_bytes")
  sha256      String   @db.VarChar(64)
  path        String
  uploadedBy  String   @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  case   Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  record FilingRecord @relation(fields: [filingId], references: [filingId], onDelete: Cascade)

  @@index([filingId])
  @@map("fee_receipt_file")
}

/// C8.2: the UCI IRCC gave one person on a recorded filing; only `uci` changes, through a correction (trigger).
model FilingPersonRecord {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  filingId    String   @map("filing_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  uci         String
  recordedBy  String   @map("recorded_by")
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  filing Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@unique([filingId, subjectId])
  @@map("filing_person_record")
}

/// C8.2 "Correct a number": the application number (field application_number) or a person's UCI (field uci, with the
/// person; a UCI added later has no before) before and after, with the reason. Append-only (trigger).
model FilingRecordCorrection {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  filingId    String   @map("filing_id") @db.Uuid
  field       String   @default("application_number")
  subjectId   String?  @map("subject_id") @db.Uuid
  before      String?
  after       String
  reason      String
  correctedBy String   @map("corrected_by")
  correctedAt DateTime @default(now()) @map("corrected_at") @db.Timestamptz

  filing Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@index([filingId])
  @@map("filing_record_correction")
}

/// C8.2 (BR-12, P-142 D7): a task on a case. Kind after_filing_change: a fact changed after filing, so the form is
/// re-signed or IRCC is told (Unconfirmed: no counsel). State open · done; one open task per item and kind.
model CaseTask {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  caseId      String    @map("case_id") @db.Uuid
  filingId    String?   @map("filing_id") @db.Uuid
  itemId      String?   @map("item_id") @db.Uuid
  kind        String
  words       String
  state       String    @default("open")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  doneBy      String?   @map("done_by")
  doneAt      DateTime? @map("done_at") @db.Timestamptz

  /// C6.17 (challenge M3): the stage current when the task was made.
  stageId String @map("stage_id") @db.Uuid

  case   Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage  CaseStage   @relation(fields: [stageId], references: [id], onDelete: NoAction)
  filing Filing?     @relation(fields: [filingId], references: [id], onDelete: Cascade)
  item   FilingItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([stageId])
  @@map("case_task")
}

/// C7.5 part 1 (BR-19; AG-11-69, -70, -71): one finding of a case's independent review, in the team's words. Severity
/// CRITICAL · MAJOR · MINOR · INFO; source rules · ai · manual; state open · acknowledged · resolved · waived (CRITICAL
/// only) · dismissed. A rules finding names its rule and a fingerprint of the facts it compared; the database keeps one
/// not-resolved row per case and fingerprint (partial unique index "review_finding_one_live_rule", in the migration).
model ReviewFinding {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  caseId      String    @map("case_id") @db.Uuid
  filingId    String?   @map("filing_id") @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  form        String?
  field       String?
  severity    String
  source      String
  ruleKey     String?   @map("rule_key")
  fingerprint String?
  state       String    @default("open")
  quote       String
  agreement   String?
  reasons     Json?
  replayed    Boolean   @default(false)
  runId       String?   @map("run_id") @db.Uuid
  stateReason String?   @map("state_reason")
  stateBy     String?   @map("state_by")
  stateAt     DateTime? @map("state_at") @db.Timestamptz
  resolvedBy  String?   @map("resolved_by")
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  /// A finding added by hand is stored once per key (one key per "Add finding" dialog), with the request's sha256.
  idempotencyKey         String? @map("idempotency_key")
  idempotencyFingerprint String? @map("idempotency_fingerprint") @db.VarChar(64)
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  /// C6.17 (challenge M3): the stage current when the finding was made.
  stageId String @map("stage_id") @db.Uuid

  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage  CaseStage @relation(fields: [stageId], references: [id], onDelete: NoAction)
  filing Filing? @relation(fields: [filingId], references: [id], onDelete: SetNull)

  @@unique([caseId, idempotencyKey])
  @@index([caseId])
  @@index([stageId])
  @@map("review_finding")
}

/// C7.6 (P-155): the representative of record's review of one filing: "reviewed", or "self_reviewed" by a solo firm's
/// one person, with the licence number. Append-only (trigger); the newest row counts.
model FilingReview {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  filingId      String   @map("filing_id") @db.Uuid
  reviewedBy    String   @map("reviewed_by")
  /// reviewed · self_reviewed
  kind          String
  licenceNumber String   @map("licence_number")
  note          String?
  /// The fingerprint of the filing's forms' facts when reviewed: a later change reopens the review (break B2, #861).
  factsHash     String   @map("facts_hash") @db.VarChar(64)
  reviewedAt    DateTime @default(now()) @map("reviewed_at") @db.Timestamptz

  filing Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)
  rounds ReviewRoundFiling[] // C8.3: the approval that wrote it

  @@index([filingId])
  @@map("filing_review")
}

/// C7.6 (AG-07 BR-26; P-237, P-238): a warning of one filing passed with a written reason; `keys` are the warning lines
/// it covered when written (engine/runtime/readiness.ts passKeys). Never the barcode block (a check). Append-only.
model ReadinessPass {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  filingId    String   @map("filing_id") @db.Uuid
  code        String
  keys        String[]
  /// critical (a former block, P-315) · warning
  severity    String
  reason      String
  passedBy    String   @map("passed_by")
  passedAt    DateTime @default(now()) @map("passed_at") @db.Timestamptz

  filing Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@index([filingId])
  @@map("readiness_pass")
}

/// C7.6 (P-151 (1)): IRCC's accepted-until date for a form edition, set with a reason; the newest row counts, null
/// clears it. Append-only (the rows are the history).
model FormEditionAcceptedUntil {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  formEditionId String    @map("form_edition_id") @db.Uuid
  acceptedUntil DateTime? @map("accepted_until") @db.Date
  reason        String
  setBy         String    @map("set_by")
  setAt         DateTime  @default(now()) @map("set_at") @db.Timestamptz

  edition FormEdition @relation(fields: [formEditionId], references: [id], onDelete: Cascade)

  @@index([formEditionId])
  @@map("form_edition_accepted_until")
}

/// C6.16 (B138): a link sent to one adult on a case, so they answer on their own (concept BR-3, BR-4). The token (32
/// random bytes, in the link's fragment) and the 6-digit code are kept only as sha256. At most one link per person is
/// not dead, and one address per case among working links (partial unique indexes in SQL). void_why: taken_back ·
/// superseded · locked · not_adult (a check in SQL).
model PersonLink {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  caseId         String    @map("case_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  /// Lower case; never in audit text (the masked address is).
  address        String
  addressMasked  String    @map("address_masked")
  addressGivenBy String    @map("address_given_by")
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  codeHash       String?   @map("code_hash") @db.Char(64)
  codeExpiresAt  DateTime? @map("code_expires_at") @db.Timestamptz
  wrongTries     Int       @default(0) @map("wrong_tries")
  sentBy         String    @map("sent_by")
  sentAt         DateTime  @default(now()) @map("sent_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  consentedAt    DateTime? @map("consented_at") @db.Timestamptz
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz
  voidWhy        String?   @map("void_why")
  voidedBy       String?   @map("voided_by")
  voidReason     String?   @map("void_reason")
  supersededById String?   @map("superseded_by_id") @db.Uuid
  /// The Send request's idempotency key: the same key again sends nothing new.
  sendKey        String?   @map("send_key")

  case         Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  subject      AnswerSubject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  supersededBy PersonLink?         @relation("PersonLinkSuperseded", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   PersonLink[]        @relation("PersonLinkSuperseded")
  sessions     PersonLinkSession[]
  messages     DemoMessage[]

  @@unique([caseId, sendKey])
  @@index([caseId])
  @@map("person_link")
}

/// C6.16: code sends (per email address) and code tries (per network address), for the limits (as extension_code_try).
/// kind: code_sent · code_try (a check in SQL).
model PersonLinkTry {
  id      BigInt   @id @default(autoincrement())
  kind    String
  address String   @db.VarChar(254)
  at      DateTime @default(now()) @db.Timestamptz

  @@index([kind, at, address])
  @@map("person_link_try")
}

/// C6.16 (BR-5): the adult's session on /api/link/* only: 8 hours, its token kept only as sha256, revoked when the link dies.
model PersonLinkSession {
  id        String    @id @default(uuid()) @db.Uuid
  linkId    String    @map("link_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  link PersonLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@map("person_link_session")
}

/// C6.16 stand-in SI-20 (email, the team's AG-10): the demo inbox by address, demo workspace only. kind: link · code.
/// A code message is deleted when the code is used or replaced; every message of a link when the link dies.
model DemoMessage {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  linkId      String   @map("link_id") @db.Uuid
  address     String
  kind        String
  subject     String
  body        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  link PersonLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([address, createdAt])
  @@map("demo_message")
}

/// C6.13 (B135, P-406 (1)): one Make principal, Remove filing, Add filing back or travelling-flag change on a case, with its
/// reason (typed changes), the roles around it and the preview basis it was applied over. Append-only (trigger).
model FilingChange {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  caseId         String   @map("case_id") @db.Uuid
  /// make_principal · remove_filing · add_back · travelling_flag
  kind           String
  subjectId      String   @map("subject_id") @db.Uuid
  /// make_principal: the former principal
  otherSubjectId String?  @map("other_subject_id") @db.Uuid
  rolesBefore    Json     @map("roles_before")
  rolesAfter     Json     @map("roles_after")
  reason         String?
  basis          String?  @db.VarChar(64)
  changedBy      String   @map("changed_by")
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, changedAt])
  @@map("filing_change")
}

/// C6.5 part 2 (P-242, P-243): one read of one stored document by one reader (mrz: coded lines by rules; ai_vision: a
/// letter, replayed from a saved read only). Its one "Confirm & use" is recorded with who and when.
model DocumentReview {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  caseId      String    @map("case_id") @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  documentId  String    @unique @map("document_id") @db.Uuid
  /// mrz · ai_vision
  reader      String
  replayed    Boolean   @default(false)
  /// [{fact, reason}]: what the reader could not read (never guessed)
  unreadable  Json
  readBy      String    @map("read_by")
  readAt      DateTime  @default(now()) @map("read_at") @db.Timestamptz
  confirmedBy String?   @map("confirmed_by")
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz

  case     Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document CaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  values   ReadValue[]

  @@index([caseId, subjectId])
  @@map("document_review")
}

/// C6.5 part 2 (BR-4): a value a read proposes, apart from answers until its document's Confirm & use.
model ReadValue {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  caseId             String    @map("case_id") @db.Uuid
  reviewId           String    @map("review_id") @db.Uuid
  documentId         String    @map("document_id") @db.Uuid
  subjectId          String    @map("subject_id") @db.Uuid
  fact               String
  valueJson          Json      @map("value_json")
  page               Int
  reader             String
  confidence         Float
  /// P-243: collapsed (check digits passed) · expanded
  review             String
  checked            Boolean   @default(false)
  note               String?
  /// proposed · used · agreed · conflict · not_asked
  state              String    @default("proposed")
  /// The answer Confirm & use wrote, or the one it agreed with
  answerId           String?   @map("answer_id") @db.Uuid
  correctedValueJson Json?     @map("corrected_value_json")
  correctedBy        String?   @map("corrected_by")
  correctedAt        DateTime? @map("corrected_at") @db.Timestamptz

  case   Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  read   DocumentReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  checks AnswerCheck[]

  @@unique([reviewId, fact])
  @@index([caseId, subjectId])
  @@map("read_value")
}

/// C6.5 part 2 (BR-7, P-242): a typed answer and a document value that differ; one open per person, fact and document (partial
/// unique index answer_check_one_open, in SQL); resolved only with a reason.
model AnswerCheck {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  caseId            String    @map("case_id") @db.Uuid
  subjectId         String    @map("subject_id") @db.Uuid
  fact              String
  readValueId       String    @map("read_value_id") @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  answerId          String    @map("answer_id") @db.Uuid
  typedValueJson    Json      @map("typed_value_json")
  documentValueJson Json      @map("document_value_json")
  /// open · resolved
  state             String    @default("open")
  /// answer · document
  kept              String?
  reason            String?
  openedBy          String    @map("opened_by")
  openedAt          DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  resolvedBy        String?   @map("resolved_by")
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz

  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  readValue ReadValue @relation(fields: [readValueId], references: [id], onDelete: Cascade)

  @@index([caseId, subjectId])
  @@map("answer_check")
}

/// C7.8 (B141, SA-1B-177 FilingFormAddition): a library form the case officer added to one filing, for one person on it,
/// never to the combination. Frozen when added (BR-4): the edition, its published map rows and the fill trial are copied
/// into `frozen` with their fingerprint, so a later library change never changes this case's form. Insert, then a
/// removed mark only (a trigger refuses any other change); the row is kept when removed (BR-8).
model FilingFormAddition {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  caseId        String        @map("case_id") @db.Uuid
  filingId      String        @map("filing_id") @db.Uuid
  /// The person on the filing it is for (BR-1): never a role.
  subjectId     String        @map("subject_id") @db.Uuid
  formKey       String        @map("form_key")
  /// The library edition it was frozen from (no foreign key: the frozen copy stands even if the library row goes).
  editionId     String        @map("edition_id") @db.Uuid
  editionLabel  String        @map("edition_label")
  /// fills (published map rows and a passed fill trial) · blank (the official PDF, filled by hand)
  kind          String
  /// The frozen form: title, official file and checksum, the published map rows, the facts' definitions they read.
  frozen        Json
  frozenSha256  String        @map("frozen_sha256") @db.VarChar(64)
  /// The fill trial it was proven by (fills only): the register's record.
  trial         Json?
  channel       FilingChannel
  /// HAND_SCANNED (default) or NONE (switched off by staff with a reason, SA-1B-102 r5).
  signature     String
  signedBy      String?       @map("signed_by")
  signatureReason String?     @map("signature_reason")
  addedBy       String        @map("added_by")
  addedAt       DateTime      @default(now()) @map("added_at") @db.Timestamptz
  reason        String?
  removedBy     String?       @map("removed_by")
  removedAt     DateTime?     @map("removed_at") @db.Timestamptz
  removedReason String?       @map("removed_reason")

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filing Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("filing_form_addition")
}

/// C8.3 (B144; P-406, P-412; concept screens/B144/concept.md r2, B1): one send for review on a case. kind: send ·
/// review_now (a solo firm: sent and opened in one step) · one_step (the C7.6 route, challenge M1) · reapprove (P-412:
/// one-click re-approve of the forms a fact change withdrew). Append-only (trigger).
model ReviewRound {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  /// Counts per case (1, 2, …).
  number      Int
  kind        String
  sentBy      String   @map("sent_by")
  sentAt      DateTime @default(now()) @map("sent_at") @db.Timestamptz

  case    Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filings ReviewRoundFiling[]
  forms   ReviewRoundForm[]

  @@unique([caseId, number])
  @@map("review_round")
}

/// C8.3 (B1, AG-7-29 r9): one filing in one round, with its own status (sent → under_review → approved | sent_back) and
/// its own round number. At most one open row per filing (partial unique index). Moves guarded by a trigger.
model ReviewRoundFiling {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  caseId            String    @map("case_id") @db.Uuid
  roundId           String    @map("round_id") @db.Uuid
  filingId          String    @map("filing_id") @db.Uuid
  filingRound       Int       @map("filing_round")
  /// sent · under_review · approved · sent_back
  status            String    @default("sent")
  openedBy          String?   @map("opened_by")
  openedAt          DateTime? @map("opened_at") @db.Timestamptz
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz
  /// Sent back: [{ text, item?, check? }] (BR-5)
  reasons           Json?
  /// Approved: the checklist item keys confirmed unticked (BR-4, AG17-D78)
  confirmedUnticked Json?     @map("confirmed_unticked")
  /// The representative of record at the decision (M2)
  representative    String?
  /// reviewed · self_reviewed
  reviewKind        String?   @map("review_kind")
  selfStatement     String?   @map("self_statement")
  filingReviewId    String?   @map("filing_review_id") @db.Uuid

  case   Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  round  ReviewRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  filing Filing            @relation(fields: [filingId], references: [id], onDelete: Cascade)
  review FilingReview?     @relation(fields: [filingReviewId], references: [id], onDelete: NoAction)
  forms  ReviewRoundForm[]
  checks ReviewCheck[]

  @@unique([roundId, filingId])
  @@unique([filingId, filingRound])
  @@index([caseId])
  @@map("review_round_filing")
}

/// C8.3 (B2): one form of a filing in a round, by filing item, frozen at send (own answer snapshot, facts hash, file:
/// validated copy · generated copy matching the facts · none · waits) and stamped once on approval.
model ReviewRoundForm {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  caseId          String    @map("case_id") @db.Uuid
  roundId         String    @map("round_id") @db.Uuid
  roundFilingId   String    @map("round_filing_id") @db.Uuid
  filingId        String    @map("filing_id") @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  formNumber      String    @map("form_number")
  subjectId       String    @map("subject_id") @db.Uuid
  snapshotId      String?   @map("snapshot_id") @db.Uuid
  factsHash       String?   @map("facts_hash") @db.VarChar(64)
  /// validated_copy · generated_copy · none · waits
  fileKind        String    @map("file_kind")
  fileId          String?   @map("file_id") @db.Uuid
  fileSha256      String?   @map("file_sha256") @db.VarChar(64)
  stampSnapshotId String?   @map("stamp_snapshot_id") @db.Uuid
  stampHash       String?   @map("stamp_hash") @db.VarChar(64)
  stampFileKind   String?   @map("stamp_file_kind")
  stampFileSha256 String?   @map("stamp_file_sha256") @db.VarChar(64)
  stampedBy       String?   @map("stamped_by")
  stampedAt       DateTime? @map("stamped_at") @db.Timestamptz

  case          Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  round         ReviewRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  filing        Filing            @relation(fields: [filingId], references: [id], onDelete: Cascade)
  row           ReviewRoundFiling @relation(fields: [roundFilingId], references: [id], onDelete: Cascade)
  item          FilingItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  snapshot      AnswerSnapshot?   @relation("ReviewFrozen", fields: [snapshotId], references: [id], onDelete: Cascade)
  stampSnapshot AnswerSnapshot?   @relation("ReviewStamp", fields: [stampSnapshotId], references: [id], onDelete: Cascade)

  @@unique([roundFilingId, itemId])
  @@index([itemId])
  @@map("review_round_form")
}

/// C8.3 (BR-2): one checklist item of a filing in a round (default · program · confirmations · form), copied when sent.
model ReviewCheck {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  caseId        String    @map("case_id") @db.Uuid
  roundFilingId String    @map("round_filing_id") @db.Uuid
  itemKey       String    @map("item_key")
  source        String
  wording       String
  /// The item's live state when sent (default items), e.g. { open: 0 } or { verified: 5, required: 5 }
  live          Json?
  tickedBy      String?   @map("ticked_by")
  tickedAt      DateTime? @map("ticked_at") @db.Timestamptz

  case Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  row  ReviewRoundFiling @relation(fields: [roundFilingId], references: [id], onDelete: Cascade)

  @@unique([roundFilingId, itemKey])
  @@map("review_check")
}
