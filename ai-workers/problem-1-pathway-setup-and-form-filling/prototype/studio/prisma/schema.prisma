// Product Studio prototype database (D275/D276). PostgreSQL through Prisma, as in the team's backend.
//
// Model and column names follow the team's pack models in
// code/ERv2-sanitized@22f1d12-2026-10-19/apps/api/prisma/models/country-pack-*.prisma
// (CanonicalField, ProgramDef, LogicalSection, SectionQuestion, DocumentType, DocumentRequirement,
// GovFormDef, FormEdition, FormFieldMap, Predicate, ConditionEffect, AttachMode) so the team can map each
// prototype record onto its own. Deliberate simplifications, reported rather than hidden:
//  - one table per definition with version/status/supersedesId columns (the team splits some into a
//    durable master plus a version child);
//  - every row carries workspaceId: the disposable demo workspace is the reset boundary (D274);
//  - no tenancy, row-level security, encryption seams or effective dating; prototype only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DefinitionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  RETIRED
}

enum ProgramNodeKind {
  PATHWAY
  PROGRAM
  STREAM
  CATEGORY
}

enum FieldDataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  ENUM
  COMPOSITE
}

/// C3.16 (SA-1B-130): CLIENT_LEVEL is the team's PERSON and CASE_LEVEL its FILING (one reader, engine/field-scope.ts).
enum FieldScope {
  CLIENT_LEVEL
  CASE_LEVEL
  HOUSEHOLD
  ORGANISATION
}

enum ConditionEffect {
  SHOW
  HIDE
  REQUIRE
  OPTIONAL
}

enum AttachMode {
  COMBINATION_MANDATORY
  ANSWER_CONDITIONAL
}

enum Origin {
  IMPORTED_RELEASE
  AI_PROPOSAL
  HUMAN
  /// F1: proposed by a deterministic match (PDF twin, form path, name or alias; no AI), accepted by a person.
  CODE_MATCH
  /// S4 (P-123): picked by the form finder (both AI rounds agree and the rules pass) and attached with no confirm step;
  /// "Picked by AI · Sample" until the immigration expert signs off at release review.
  AI_FOUND
}

enum SourceBasis {
  SOURCE_BACKED
  ILLUSTRATIVE
}

/// F1 (P-61 §2) as amended by P-143 (W1-10 slice 1): how one form line of a combination is filed. Online (typed into the
/// portal's screens) · PDF upload (IRCC's PDF filled, validated, uploaded) · Paper (filled, validated, printed, signed in
/// pen, mailed) · Not needed (the IRCC account asks it itself). The combination's filing method is worked out from the
/// lines (engine/channels.ts), never stored. "Signed PDF upload" became PDF upload + HAND_SCANNED.
enum FilingChannel {
  PDF_UPLOAD
  ONLINE
  PAPER
  NOT_NEEDED
}

/// P-143: how a line is signed, its own value beside the channel (contracts/forms.ts SIGNATURE_FITS says which fit).
enum SignatureKind {
  TYPED_NAME
  HAND_SCANNED
  PEN
  NONE
}

/// F1 (challenge point 2): an edition is the PDF file, or an online version read from captured portal screens.
enum EditionChannel {
  PDF
  ONLINE
}

/// The disposable demo workspace. Reset deletes every row that belongs to it and its working files.
model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("workspace")
}

// ─── Programs and combinations ──────────────────────────────────────────────────────────────────

/// Pathway › program › stream › category, as the team's ProgramDef (parentNodeKey, not a self-FK).
model ProgramDef {
  id             String          @id @default(uuid()) @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  programNodeKey String          @map("program_node_key")
  parentNodeKey  String?         @map("parent_node_key")
  nodeKind       ProgramNodeKind @map("node_kind")
  label          String
  /// BR-6 in the database (QA-14): the name compared ignoring case, spaces and punctuation (contracts/programs.ts
  /// normalizeLabel). A partial unique index (migration 20261024090000) keeps one name per parent, also when two people
  /// create it at the same moment. Null only on rows that were duplicates before the index existed.
  nameKey        String?         @map("name_key")
  description    String?
  sourceBasis    SourceBasis     @default(SOURCE_BACKED) @map("source_basis")
  /// PATHWAY only (SA-1B-50/51, W1-03 P-104): the Pathway type, INDIVIDUAL (Retail) or CORPORATE (Corporate and
  /// employers), a fixed value (contracts/structure.ts PATHWAY_TYPES), never a row; several Pathways per type.
  clientType     String?         @map("client_type")
  /// Category / sub-category (SA-1B-51): locations a case may choose when it is opened (inside/outside Canada is a
  /// case detail, not a level). The prototype's sourced rows allow "outside_canada" only.
  allowedLocations String[]      @default([]) @map("allowed_locations")
  displayOrder   Int             @default(0) @map("display_order")
  /// Screen 01 (P-26): a plain label under the name for a route step or a supporting application, for example
  /// "Step 1 of 2 · followed by Permanent residence application" or "Supported by: Corporate › LMIA". A label only:
  /// no link record and no behaviour behind it yet.
  linkLabel      String?         @map("link_label")
  createdBy      String          @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  /// W1-03: raised by every rename or location edit; a PATCH with an older version is refused with the current row.
  version        Int             @default(1)
  /// P-116 (P-52 L2): a retired name is hidden from pickers and AI; earlier releases and open cases keep it. Set by the
  /// release that carries its approved retire (api/src/lifecycle.ts); cleared by a released restore.
  retiredAt      DateTime?       @map("retired_at") @db.Timestamptz
  retiredBy      String?         @map("retired_by")

  combination Combination?

  @@unique([workspaceId, programNodeKey])
  @@map("program_def")
}

/// The combination: one filing type at the last level present (a category without sub-categories, or a sub-category),
/// SA-1B-55. Exactly one per leaf node (unique programDefId); it owns one configuration: forms, document requirements,
/// rules, checks and section selection. `participants` (who it applies to) is an adapter kept until Screen 03 moves
/// people onto lines as roles.
model Combination {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @map("workspace_id") @db.Uuid
  programDefId   String      @map("program_def_id") @db.Uuid
  combinationKey String      @map("combination_key")
  label          String
  description    String?
  /// [{ role: "principal"|"spouse_or_partner"|"child"|"representative", label, min, max }]
  participants   Json
  sourceBasis    SourceBasis @default(SOURCE_BACKED) @map("source_basis")
  /// C11.9 (P-116): the filing order of its forms, as form-line lineage keys; null keeps the order by line key.
  formOrder      Json?       @map("form_order")
  basisNote      String?     @map("basis_note")
  /// W1-10 slice 1 (P-143, plan §8 Q1): the IRCC account this filing goes through (contracts/forms.ts IRCC_ACCOUNTS,
  /// Sample until the immigration expert confirms). What IRCC accepts is read for this account (C-3). Null: not set.
  portalKey      String?     @map("portal_key")
  createdBy      String      @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  /// P-116 / addendum A2: set by the release that carries an approved retire. No new case opens on it (runtime.ts);
  /// open cases keep their pinned release.
  retiredAt      DateTime?   @map("retired_at") @db.Timestamptz
  retiredBy      String?     @map("retired_by")
  /// S5 (challenge M4): "Who can be in this application" is saved with the version it was read at; a stale save is a
  /// 409 naming who saved last. Every save writes an audit row with the list before it, which Undo restores.
  participantsVersion Int     @default(1) @map("participants_version")
  participantsBy      String? @map("participants_by")
  /// C6.9 part 1 (BR-1…BR-6): the draft's eligibility gates as data, { gates[{key,label,condition}], judgement[],
  /// disclaimer|null, version, by }; a release copies { gates, judgement, disclaimer } into snapshot.eligibility. Null:
  /// none set, so the snapshot and its fingerprint stay as before.
  eligibility         Json?

  program      ProgramDef            @relation(fields: [programDefId], references: [id], onDelete: Restrict)
  attachments  SourceAttachment[]
  forms        CombinationForm[]
  captures     PortalCapture[]
  sections     SqrSectionSelection[]
  requirements DocumentRequirement[]
  factSources  FactSource[] // W1-15 slice 1
  rules        Predicate[]
  checks       Check[]
  releases     ConfigRelease[]
  jobs         DraftingJob[]
  cases        Case[] // runtime lane (R1)
  caseStages   CaseStage[] // C6.17
  answerKeys   AnswerKey[] // G4 (C5.7)

  @@unique([workspaceId, combinationKey])
  @@unique([programDefId])
  @@map("combination")
}

/// S5 (challenge M3, S6 m1, P-119): the kinds of person a combination's "Who can be in this application" may list, one
/// list read by the editor, the validator and the runtime. takesPartInCase: the person joins a case (else they are only
/// described on forms, e.g. a parent named on IMM 5707); mayBeApplicant: the person may file their own application.
/// The six built-in starting roles (samples/person-roles.json) are created with the workspace and kept by Reset
/// (founder, P-108 note); S6 adds the one Add for new roles. basis: SAMPLE until the immigration expert confirms.
model PersonRole {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  roleKey         String    @map("role_key")
  label           String
  meaning         String
  takesPartInCase Boolean   @map("takes_part_in_case")
  mayBeApplicant  Boolean   @map("may_be_applicant")
  basis           String    @default("SAMPLE")
  builtIn         Boolean   @default(false) @map("built_in")
  displayOrder    Int       @default(0) @map("display_order")
  retiredAt       DateTime? @map("retired_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([workspaceId, roleKey])
  @@map("person_role")
}

// ─── Sources and forms ──────────────────────────────────────────────────────────────────────────

/// An uploaded official form, checklist, guide or page. Only files whose bytes match the official manifest
/// are "recognised"; anything else is held (no AI drafting, no reading).
model SourceAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  combinationId  String   @map("combination_id") @db.Uuid
  kind           String
  fileName       String   @map("file_name")
  storedPath     String   @map("stored_path")
  sha256         String
  bytes          Int
  recognised     Boolean
  officialFile   String?  @map("official_file")
  edition        String?
  approval       String?
  status         String
  statusDetail   String?  @map("status_detail")
  /// MANUAL (a person chose the file) or SAMPLE (the Load sample inputs button chose it); same handling.
  uploadedVia    String   @map("uploaded_via")
  uploadedBy     String   @map("uploaded_by")
  inventoryFile  String?  @map("inventory_file")
  inventorySummary Json?  @map("inventory_summary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sha256])
  @@map("source_attachment")
}

model GovFormDef {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  formKey     String  @map("form_key")
  displayName String  @map("display_name")
  /// "data_form" (an XFA form the system fills) or "document" (a checklist or instructions)
  /// S4 (M5) adds "guide" and "checklist": stored once in the library, read by AI, never filled ("document" stays for rows
  /// made before S4).
  formKind    String  @default("data_form") @map("form_kind")
  /// P-319 (founder, 4 Nov: "no combination is hard-coded"): what the form is to IRCC's rules, set per form by an author in
  /// the library (contracts/form-library.ts FORM_ROLES): "family_information" (IMM 5707, IMM 5645 on the demo; [IRCC-F09]
  /// reads it). Null: no role. Released with each combination's snapshot (engine/snapshot.ts form_role).
  formRole    String? @map("form_role")
  /// S4: the form's own canada.ca page (where the edition and its PDF link are read; never a guide's link).
  formPageUrl String? @map("form_page_url")
  /// S4 (m2, P-116): retired by a release that carries an approved retire; hidden from pickers and AI, kept by releases.
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz
  retiredBy   String?   @map("retired_by")
  /// Which source drafting reads for this form (P-62 §1, C2.10): PDF_FIRST (the PDF version first, then the online
  /// screens for what differs; the default) or ONLINE_ONLY (the online screens alone: the PDF version is not reused).
  draftFrom   String  @default("PDF_FIRST") @map("draft_from")
  /// X5 (P-156 (1)): when IRCC's forms index last listed this number (the library fill, US$0), and the index's date
  /// modified for it then.
  listedOnIndexAt   DateTime? @map("listed_on_index_at") @db.Timestamptz
  indexDateModified String?   @map("index_date_modified")

  editions FormEdition[]
  usedBy   CombinationForm[]

  @@unique([workspaceId, formKey])
  @@map("gov_form_def")
}

/// W1-10 slice 1 (P-143, C-3): what IRCC accepts for one form edition through one IRCC account (contracts/forms.ts
/// IRCC_ACCOUNTS, or ANY: every account). Basis AI_SAMPLE · PERSON_SAMPLE · SAMPLE_FIXTURE · FOUNDER_SAMPLE · EXPERT,
/// with IRCC's line it was read from (P-170: page, quote, date read), or null where none was found.
model FormEditionAccept {
  id            String          @id @default(uuid()) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  formEditionId String          @map("form_edition_id") @db.Uuid
  account       String
  channels      FilingChannel[]
  basis         String
  quote         String?
  sourceUrl     String?         @map("source_url")
  readOn        DateTime?       @map("read_on") @db.Date
  setBy         String          @map("set_by")
  setAt         DateTime        @default(now()) @map("set_at") @db.Timestamptz

  edition FormEdition @relation(fields: [formEditionId], references: [id], onDelete: Cascade)

  @@unique([formEditionId, account])
  @@index([workspaceId])
  @@map("form_edition_accept")
}

model FormEdition {
  id             String  @id @default(uuid()) @db.Uuid
  workspaceId    String  @map("workspace_id") @db.Uuid
  govFormDefId   String  @map("gov_form_def_id") @db.Uuid
  editionLabel   String  @map("edition_label")
  officialFile   String? @map("official_file")
  sha256         String?
  inventoryFile  String? @map("inventory_file")
  dataBoundBoxes Int     @default(0) @map("data_bound_boxes")
  /// Screen 01 uploads (P-25): the uploaded PDF kept outside the web root, so "+ Add" can attach it to another row.
  storedPath     String? @map("stored_path")
  /// F1: PDF (the file) or ONLINE (an online version: the portal twin of an approved capture, P-66). An online version's
  /// identity is contentSha256, the fingerprint of its normalised screens (saved pages differ byte for byte per save);
  /// sha256 stays the PDF's file checksum. inventoryFile holds the twin (screens, inputs, options) for both channels.
  channel        EditionChannel @default(PDF)
  portalKey      String?   @map("portal_key")
  capturedOn     DateTime? @map("captured_on") @db.Date
  /// The date the online version must be checked again (validator: an Online line needs a version within it).
  recheckBy      DateTime? @map("recheck_by") @db.Date
  contentSha256  String?   @map("content_sha256")
  /// S4: where this edition came from: SAMPLE (Load sample, committed copies) · UPLOADED (a person) · DOWNLOADED
  /// (the form finder, from canada.ca). Null on rows made before S4.
  origin         String?
  /// S4: the canada.ca form page and the PDF link the file was taken from, the "Last updated" (YYYY-MM) that page showed,
  /// and when the library last compared it with canada.ca (EXPERIENCE §2.11 freshness).
  formPageUrl    String?   @map("form_page_url")
  sourceUrl      String?   @map("source_url")
  canadaUpdated  String?   @map("canada_updated")
  checkedAt      DateTime? @map("checked_at") @db.Timestamptz
  /// X5 (PR #146): IRCC's index date last seen as current for this file: set by a "Check against canada.ca" that found it
  /// current (an undated file: by the fill's reads). engine/library-index.ts newerOnIndex.
  indexDateSeenCurrent String? @map("index_date_seen_current")
  /// S4 (M6): canada.ca now serves a different file for this same printed edition; a person decides to Replace.
  newerFileSha256 String?  @map("newer_file_sha256")
  /// C3.12: the date the file says it was published (YYYY-MM-DD; its ModDate, else CreationDate), not the printed edition.
  /// Null: not read yet (the Forms list reads it once); "": read, and the file names no date.
  published       String?

  form GovFormDef     @relation(fields: [govFormDefId], references: [id], onDelete: Cascade)
  maps FormFieldMap[]
  recaptureTasks RecaptureTask[]
  accepts        FormEditionAccept[]
  acceptedUntil  FormEditionAcceptedUntil[] // C7.6, P-151 (1)

  @@unique([workspaceId, editionLabel])
  @@map("form_edition")
}

/// The one form intake (P-51): one row per file a person (or the sample loader) handed in, with what was read from the
/// file and the outcome. Held rows wait for a person: a new edition of a form already in the library (impact review,
/// P-32/P-38; never attached or used silently) or a file whose code and edition could not be read.
model IntakeItem {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  /// The combination it was uploaded on (door 1); null for the Forms library's own "Add forms" (door 2, Screen 04).
  combinationId String?  @map("combination_id") @db.Uuid
  fileName      String   @map("file_name")
  storedPath    String   @map("stored_path")
  sha256        String
  bytes         Int
  /// form · checklist · guide · unknown, read from the file
  kind          String
  code          String?
  title         String?
  editionLabel  String?  @map("edition_label")
  published     String?
  /// in_library · added · attached · new_edition_held · held · refused
  outcome       String
  /// HELD (waits for a person) or DONE
  status        String
  reason        String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// P-80: the IRCC page the uploader says a held file came from, for the second person to compare.
  irccPage      String?  @map("ircc_page")
  /// S4 (S5 ask): uploaded from this combination's "Not found" row for this form: attached when the file becomes usable.
  forCombinationId String? @map("for_combination_id") @db.Uuid
  forCode       String?  @map("for_code")

  @@index([workspaceId, status])
  @@index([workspaceId, sha256])
  @@map("intake_item")
}

/// P-80: a held file a second person approved in the product. The intake treats a file as approved when its checksum is
/// on the official manifest or here; approver and uploader are different people (server rule).
/// S4 (M2, Q-L1): a file the system downloaded from canada.ca, or a hand upload whose checksum equals the PDF behind the
/// canada.ca form page's link. It carries the same evidence as the official manifest (official host, the form page, the
/// PDF link, the checksum, when), so it needs no second person; who started the run is recorded, not "approved".
model OfficialDownload {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  sha256      String
  /// form · checklist · guide
  kind        String
  code        String?
  edition     String?
  title       String?
  formPageUrl String   @map("form_page_url")
  sourceUrl   String   @map("source_url")
  fileName    String   @map("file_name")
  storedPath  String   @map("stored_path")
  bytes       Int
  /// download (fetched by the finder) · fingerprint_match (a hand upload equal to canada.ca's file, Q-L1)
  basis       String
  batchId     String?  @map("batch_id") @db.Uuid
  startedBy   String   @map("started_by")
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  @@unique([workspaceId, sha256])
  @@map("official_download")
}

/// F2 (forms, P-156 (2), P-176; setup checklist step 1): the official page a person confirmed for a combination. The rules'
/// proposal is worked out from the combination's attached pages on every read (engine/official-pages.ts), so only the
/// confirmation is stored: which page, who, and on which tier (author: the rules found exactly one page; expert: they did not).
model OfficialPagesRecord {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  combinationId String   @unique @map("combination_id") @db.Uuid
  attachmentId  String   @map("attachment_id") @db.Uuid
  matches       Int
  confirmedBy   String   @map("confirmed_by")
  confirmedAs   String   @map("confirmed_as")
  confirmedAt   DateTime @default(now()) @map("confirmed_at") @db.Timestamptz

  @@index([workspaceId])
  @@map("combination_official_pages")
}

/// X5 slice c (P-156 (1); the tech lead on #138): a form a second person approved deleting from the library is remembered,
/// so a later fill from IRCC's forms list does not list it again. A person adding the form back (an upload, a canada.ca
/// download by Find again, a sample load) forgets it. Keyed by form number; no foreign key (the form's row is gone).
model LibraryFormDeletion {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  formKey     String   @map("form_key")
  deletedBy   String   @map("deleted_by")
  changeId    String?  @map("change_id") @db.Uuid
  deletedAt   DateTime @default(now()) @map("deleted_at") @db.Timestamptz

  @@unique([workspaceId, formKey])
  @@map("library_form_deletion")
}

model ApprovedSource {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  sha256       String
  kind         String
  code         String?
  edition      String?
  fileName     String   @map("file_name")
  irccPage     String   @map("ircc_page")
  intakeItemId String?  @map("intake_item_id") @db.Uuid
  uploadedBy   String   @map("uploaded_by")
  approvedBy   String   @map("approved_by")
  approvedAt   DateTime @default(now()) @map("approved_at") @db.Timestamptz

  @@unique([workspaceId, sha256])
  @@map("approved_source")
}

/// Screen 02 slice 2 / Screen 04 (B1, M6): one change to the shared library that a second person approves, kept outside
/// the snapshot. action ADD · DELETE · RETIRE · RESTORE · EDIT_RULE; status WAITING · APPROVED · RETURNED · RELEASED.
/// Both release paths publish APPROVED changes through publishLibraryChanges; a combination using an item whose ADD is
/// still WAITING is not released.
model LibraryChange {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  /// field · section · document_type · check
  kind           String
  key            String
  label          String?
  action         String
  reason         String?
  aiVerdict      String?   @map("ai_verdict")
  matches        Json      @default("[]")
  meaningChecked Boolean   @default(false) @map("meaning_checked")
  status         String
  proposedBy     String    @map("proposed_by")
  proposedAt     DateTime  @default(now()) @map("proposed_at") @db.Timestamptz
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz
  decisionNote   String?   @map("decision_note")
  /// The pack version that published it.
  releasedIn     Int?      @map("released_in")
  version        Int       @default(1)
  sourceJobId    String?   @map("source_job_id") @db.Uuid
  combinationId  String?   @map("combination_id") @db.Uuid
  /// Who applied the draft that created it (break M2): never its approver either.
  appliedBy      String?   @map("applied_by")
  /// S6 slice 1a: the proposal it came from and the batch it was accepted in (grouped approval and Undo, slice 1b).
  proposalItemId String?   @map("proposal_item_id") @db.Uuid
  batchId        String?   @map("batch_id") @db.Uuid

  @@index([workspaceId, status])
  @@map("library_change")
}

/// Which forms a combination files, for whom, and when (always or under a condition).
model CombinationForm {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  combinationId String           @map("combination_id") @db.Uuid
  govFormDefId  String           @map("gov_form_def_id") @db.Uuid
  lineageKey    String           @map("lineage_key")
  who           String
  attachMode    AttachMode       @map("attach_mode")
  predicateJson Json?            @map("predicate_json")
  conditionPlain String?         @map("condition_plain")
  sourceQuote   String?          @map("source_quote")
  version       Int              @default(1)
  status        DefinitionStatus
  supersedesId  String?          @map("supersedes_id") @db.Uuid
  origin        Origin
  /// F1 (P-61 §2): how this line is filed. Existing lines stay PDF upload (today's behaviour).
  channel       FilingChannel    @default(PDF_UPLOAD)
  /// P-143: how the line is signed (C-2: it must fit the channel).
  signature     SignatureKind    @default(NONE)
  /// S5: the age a person must have reached for the line to apply to them (null: any age), and who signs it
  /// (contracts/workspace.ts SIGNED_BY). Both Sample until the immigration expert confirms.
  minAge        Int?             @map("min_age")
  signedBy      String?          @map("signed_by")
  /// C1.8 (Screen 03 concept, "Who and copies"): how many copies of this form each person it names files, 1 to 9
  /// (database check). Default 1, today's behaviour. Sample until the immigration expert confirms.
  copies        Int              @default(1)
  /// S4: the form-finder run that attached this line (AI_FOUND), for "Picked by AI" and its Undo.
  finderBatchId String?          @map("finder_batch_id") @db.Uuid
  updatedBy     String           @map("updated_by")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  form        GovFormDef  @relation(fields: [govFormDefId], references: [id], onDelete: Cascade)

  @@unique([combinationId, lineageKey, version])
  @@map("combination_form")
}

/// S4 (P-123): one change to a combination's forms list (attach, remove, the finder's automatic attach), kept so "Undo
/// last change" reverses exactly it while the draft is open. detail holds the forms and line versions it touched.
model FormLineAction {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  combinationId String    @map("combination_id") @db.Uuid
  /// attach · remove · finder_attach · edit (a line setting saved on the combination's Forms tab, S5)
  action        String
  detail        Json
  by            String
  at            DateTime  @default(now()) @db.Timestamptz
  undoneAt      DateTime? @map("undone_at") @db.Timestamptz
  undoneBy      String?   @map("undone_by")

  @@index([combinationId, at])
  @@map("form_line_action")
}

/// X2b slice (b) (C1.5, concept v3 BR-C3, BR-C4): one copy or removal of a form or document line across many combinations,
/// written in one transaction. The idempotency key makes a retried request change nothing twice; `targets` holds, per
/// combination, the line rows before and after (what one Undo puts back, and how it sees a later change). Undo is done
/// or refused as a whole and never undoes past a later release.
model LineBatch {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  idempotencyKey      String    @map("idempotency_key")
  actor               String
  /// add · remove (database check)
  op                  String
  /// form · document (database check)
  kind                String
  /// The line's key on the source combination (a form number, or a document line key).
  lineKey             String    @map("line_key")
  sourceCombinationId String    @map("source_combination_id") @db.Uuid
  /// [{ combinationId, label, keys[], before: rows[], after: [{ id, status, version, sig }] }]
  targets             Json
  at                  DateTime  @default(now()) @db.Timestamptz
  undoneAt            DateTime? @map("undone_at") @db.Timestamptz
  undoneBy            String?   @map("undone_by")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, at])
  @@map("line_batch")
}

/// One box of one form edition and the fact that fills it. The team stores entries as Json on
/// FormFieldMap; rows here so reuse ("which boxes read this field, for whom") is a query.
model FormFieldMap {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  formEditionId     String           @map("form_edition_id") @db.Uuid
  dataPath          String           @map("data_path")
  caption           String?
  heading           String?
  outcome           String
  person            String?
  row               Int?
  canonicalFieldKey String?          @map("canonical_field_key")
  transform         String?
  condition         String?
  /// B86 (QA-237): the question's own condition, in the condition language, once a person has said this form field's
  /// words say the same and a second person approved. Null = not confirmed. `condition` (the AI's words) is never read as one.
  conditionRule     Json?            @map("condition_rule")
  confidence        String?
  evidenceQuote     String?          @map("evidence_quote")
  reason            String?
  version           Int              @default(1)
  status            DefinitionStatus
  supersedesId      String?          @map("supersedes_id") @db.Uuid
  origin            Origin
  draftingRunId     String?          @map("drafting_run_id")
  /// F1, online versions: the portal screen and the input's place on it (dataPath holds the page's element id or name).
  screenKey         String?          @map("screen_key")
  screenOrder       Int?             @map("screen_order")
  inputOrder        Int?             @map("input_order")
  /// F1 (challenge point 3): { map: { answer-list value key: this form field's code }, unused: [codes of this form
  /// field that no value fills] }. `map` is the team's ENUM transform map (onMissing REFUSE).
  optionMap         Json?            @map("option_map")
  /// F1-P (Screen 02 Q3): a list row's purpose and overflow, { kind, overflow } (contracts/forms.ts LIST_PURPOSES).
  /// Only on a row-level map (row set); null = "Purpose: not set" (a release warning).
  listPurpose       Json?            @map("list_purpose")
  updatedBy        String           @map("updated_by")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  edition FormEdition @relation(fields: [formEditionId], references: [id], onDelete: Cascade)

  @@unique([formEditionId, dataPath, version])
  @@index([workspaceId, canonicalFieldKey])
  @@map("form_field_map")
}

// ─── The shared library ─────────────────────────────────────────────────────────────────────────

/// One meaning, independent of whose value it is (the same key for the applicant's and the partner's
/// date of birth). Values for people and cases are never stored here.
model CanonicalField {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  canonicalFieldKey String           @map("canonical_field_key")
  version           Int
  status            DefinitionStatus
  supersedesId      String?          @map("supersedes_id") @db.Uuid
  meaning           String
  valueType         String           @map("value_type")
  dataType          FieldDataType    @map("data_type")
  scope             FieldScope
  subjectKind       String           @map("subject_kind")
  origin            Origin
  sourceRef         String?          @map("source_ref")
  note              String?
  /// P-65: labels this field carries on forms and portal screens ("Date of birth", "DOB"), and the ids of fields merged
  /// into it. Matching tries form path, then these, before any AI.
  aliases           String[]         @default([])
  /// P-65 reviewed merge: set on the merged-away field's closing version; its id redirects to this key.
  mergedIntoKey     String?          @map("merged_into_key")
  /// Screen 02 slice 2 (Screen 04 M1): the field's name and group, outside the snapshot. Back-filled rows carry
  /// labelChecked false until a person confirms the name. New keys come from keyFor(subject, group, label).
  label             String?
  groupKey          String?          @map("group_key")
  labelChecked      Boolean          @default(false) @map("label_checked")
  /// F1 (challenge point 3): the answer list a choice field takes its values from (the team's CanonicalField.enumSetId).
  answerListKey     String?          @map("answer_list_key")
  /// C7.9 (row B142, L-SA8; P-242; SA-1B-1 rule 9): the immigration expert's "must verify before filing" flag. Set only
  /// through a library change the expert approves (api/src/must-verify.ts); a client-given value no one on staff checked
  /// raises a CRITICAL warning on Ready to file, passable with a reason (P-237), never a block.
  mustVerifyBeforeFiling Boolean   @default(false) @map("must_verify_before_filing")
  updatedBy         String           @map("updated_by")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  answers ClientCanonicalAnswer[] // runtime lane (R1): answers point at the exact field version

  @@unique([workspaceId, canonicalFieldKey, version])
  @@map("canonical_field")
}

/// F1 (challenge point 3): one list of values a choice field can take, mirroring the team's EnumSet. Each form field's
/// own codes map to these values per channel (FormFieldMap.optionMap).
model AnswerList {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  answerListKey String           @map("answer_list_key")
  version       Int
  status        DefinitionStatus
  label         String
  sourceBasis   SourceBasis      @default(ILLUSTRATIVE) @map("source_basis")
  origin        Origin
  updatedBy     String           @map("updated_by")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  values AnswerListValue[]

  @@unique([workspaceId, answerListKey, version])
  @@map("answer_list")
}

/// The team's EnumSetValue.
model AnswerListValue {
  id           String @id @default(uuid()) @db.Uuid
  answerListId String @map("answer_list_id") @db.Uuid
  valueKey     String @map("value_key")
  label        String
  sortOrder    Int    @map("sort_order")

  list AnswerList @relation(fields: [answerListId], references: [id], onDelete: Cascade)

  @@unique([answerListId, valueKey])
  @@map("answer_list_value")
}

/// P-65 reviewed merge of two shared fields: proposed by one person, applied when a different person approves. The
/// merged-away id becomes an alias that redirects; draft mappings, rules and placements move; releases stay as released.
model FieldMerge {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  keepKey      String    @map("keep_key")
  mergeKey     String    @map("merge_key")
  reason       String
  /// PROPOSED · APPLIED · REJECTED
  status       String
  proposedBy   String    @map("proposed_by")
  proposedAt   DateTime  @default(now()) @map("proposed_at") @db.Timestamptz
  decidedBy    String?   @map("decided_by")
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz
  decisionNote String?   @map("decision_note")
  /// What moved when it was applied: counts per kind of row.
  moved        Json?

  @@index([workspaceId, status])
  @@map("field_merge")
}

/// P-66 capture record: the structure of one portal application's screens (never an answer), from saved blank pages,
/// the spreadsheet template or (F2) the extension. Held until a second person approves it (P-57 amended for this kind);
/// approval makes it an online version (FormEdition, channel ONLINE). The page files themselves are not kept: only
/// their checksums and the structure read from them (a page can show a client's data as text).
model PortalCapture {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  portalKey       String    @map("portal_key")
  formKey         String    @map("form_key")
  title           String
  applicationType String?   @map("application_type")
  /// saved_page · template · extension · screenshots (P-66 §1 ways A–D)
  way             String
  /// OPEN (screens being added) · HELD (finished, waiting for a second person) · APPROVED · RETURNED · IN_LIBRARY
  /// (identical to an approved version) · ABANDONED (given up by an author; kept for the audit)
  status          String
  statusDetail    String?   @map("status_detail")
  /// The capture record (contracts/portal-capture.v1.schema.json).
  record          Json
  files           Json      @default("[]")
  /// Bumped by every write: a write that read an older revision is refused (two adds, or an add during finish).
  revision        Int       @default(0)
  contentSha256   String?   @map("content_sha256")
  /// The approved online version this capture changes, with the field-by-field difference (P-66 §2.3).
  changesEditionId String?  @map("changes_edition_id") @db.Uuid
  difference      Json?
  twinFile        String?   @map("twin_file")
  reviewFile      String?   @map("review_file")
  formEditionId   String?   @map("form_edition_id") @db.Uuid
  capturedOn      DateTime  @default(now()) @map("captured_on") @db.Date
  capturedBy      String    @map("captured_by")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz
  decisionNote    String?   @map("decision_note")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// The combination an author added this online form from (Screen 01 "Add an online form", C2.7); null when it was
  /// captured from the library. The online version itself belongs to the library, not to the combination.
  combinationId   String?   @map("combination_id") @db.Uuid
  combination     Combination? @relation(fields: [combinationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, formKey, portalKey])
  @@index([combinationId])
  @@map("portal_capture")
}

model LogicalSection {
