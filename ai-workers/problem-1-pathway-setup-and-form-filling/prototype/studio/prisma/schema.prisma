}

model DocumentType {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  documentTypeKey String           @map("document_type_key")
  name            String
  category        String
  /// Facts a supported document of this type can supply (closes P5 finding D36 in the prototype model).
  suppliesFacts   String[]         @default([]) @map("supplies_facts")
  /// W1-15 (Lead on M6): whom a supplied fact is about when it is not the holder: { fact: "holder.spouse" | "holder.parent" }.
  /// A fact not listed is about the holder (the person the checklist line names).
  suppliesAbout   Json?            @map("supplies_about")
  readerProfile   Json?            @map("reader_profile")
  /// C6.15 (SA-1B-19): named substitute sets, [{ name, mode: "any_one" | "all_together", members: [{ key, when? }] }];
  /// null = the type is its own only member. Set only through a second person's approval (api/src/document-sets.ts).
  sets            Json?
  /// C6.14 (SA-1B-151 §7): ordered person-role keys who provide this document when a line asks it once for the
  /// application or once for the couple; empty = not set (the person the item is for provides it).
  defaultProviderRoles String[]    @default([]) @map("default_provider_roles")
  version         Int
  status          DefinitionStatus
  supersedesId    String?          @map("supersedes_id") @db.Uuid
  origin          Origin
  updatedBy       String           @map("updated_by")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, documentTypeKey, version])
  @@map("document_type")
}

model DocumentRequirement {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  combinationId   String           @map("combination_id") @db.Uuid
  lineageKey      String           @map("lineage_key")
  documentTypeKey String           @map("document_type_key")
  attachMode      AttachMode       @map("attach_mode")
  predicateJson   Json?            @map("predicate_json")
  conditionPlain  String?          @map("condition_plain")
  appliesToRoles  String           @map("applies_to_roles")
  providedBy      String           @map("provided_by")
  isRequired      Boolean          @default(true) @map("is_required")
  /// W1-15 slice 3: the line's place in each person's checklist (null keeps the default order)
  position        Int?
  /// W1-15 slice 3: library document type keys that count instead of this one ("any one counts")
  alternatives    Json?
  /// C6.15 (SA-1B-20): the named set of this document type the line picks; null = the set named "Standard".
  setName         String?          @map("set_name")
  /// M3-S3, M3-S4 (P-171 (6), P-172): "waivable" lets the case officer waive the line on a case with a reason; "never":
  /// no waiver and no Not applicable, and Ready to file is blocked until it is received; null: neither (a warning).
  waiver          String?
  sourceQuote     String?          @map("source_quote")
  sourceFile      String?          @map("source_file")
  note            String?
  version         Int
  status          DefinitionStatus
  supersedesId    String?          @map("supersedes_id") @db.Uuid
  origin          Origin
  updatedBy       String           @map("updated_by")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@unique([combinationId, lineageKey, version])
  @@map("document_requirement")
