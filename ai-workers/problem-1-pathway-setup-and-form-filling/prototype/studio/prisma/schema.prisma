  workspaceId   String    @map("workspace_id") @db.Uuid
  combinationId String    @map("combination_id") @db.Uuid
  draftSha256   String    @map("draft_sha256")
  submittedBy   String    @map("submitted_by")
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  status        String
  changeSummary Json      @map("change_summary")
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz
