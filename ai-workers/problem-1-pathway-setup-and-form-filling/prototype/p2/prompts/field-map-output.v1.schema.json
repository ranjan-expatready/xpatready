{
  "type": "object",
  "additionalProperties": false,
  "required": ["form_edition", "canonical_fields", "entries"],
  "properties": {
    "form_edition": { "type": "string", "description": "as printed on the form, e.g. IMM 0000 (MM-YYYY)" },
    "canonical_fields": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "meaning", "value_type"],
        "properties": {
          "id": { "type": "string" },
          "meaning": { "type": "string" },
          "value_type": { "enum": ["text", "date", "code", "yes_no", "number", "address", "country"] }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["data_path", "outcome", "person", "row", "fact", "transform", "condition", "confidence", "unresolved_reason", "evidence_quote"],
        "properties": {
          "data_path": { "type": "string" },
          "outcome": { "enum": ["mapped", "unresolved", "never_filled", "not_a_fact"] },
          "person": { "enum": ["form_subject", "subject_spouse_or_partner", "subject_parent_1", "subject_parent_2", "subject_child", "subject_sibling", "representative", "none"] },
          "row": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
          "fact": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "transform": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "condition": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "unresolved_reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "evidence_quote": { "type": "string" }
        }
      }
    }
  }
}
