{
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "placements", "unresolved"],
  "properties": {
    "sections": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "title", "meaning", "new"],
        "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "meaning": { "type": "string" }, "new": { "type": "boolean" } } }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact", "section_id", "repeats", "tier", "collected_from", "client_visible", "reason", "alternatives", "confidence"],
        "properties": {
          "fact": { "type": "string" },
          "section_id": { "type": "string" },
          "repeats": { "enum": ["once_per_case", "per_person", "per_row"] },
          "tier": { "enum": ["lead", "prospect", "case"] },
          "collected_from": { "enum": ["client_questionnaire", "staff_working_view", "profile_record", "verified_document", "existing_record"] },
          "client_visible": { "type": "boolean" },
          "reason": { "type": "string" },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["fact", "reason"], "properties": { "fact": { "type": "string" }, "reason": { "type": "string" } } }
    }
  }
}
