 "mergify": {
  "path": ".mergify.yml",
  "max_parallel_checks": 12,
  "mode": "parallel",
  "capacities_required": {"money": 1, "migrations": 1, "pipeline": 1},
  "barrier_files_required": ["**/package.json", "**/package-lock.json", ".nvmrc", "tsconfig.base.json", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/api/tsconfig.json", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/web/tsconfig.json", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/prisma/schema/base.prisma", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/prisma/schema/links.prisma", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/prisma/schema/extension.prisma", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/prisma/schema/audit.prisma", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/prisma/migrations/migration_lock.toml", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/api/src/main.ts", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/api/src/core.ts", "ai-workers/problem-1-pathway-setup-and-form-filling/prototype/studio/api/src/studio.ts"],
  "queue_order": ["verdicts", "product", "pipeline", "records"],
  "queues": {
   "verdicts": {
    "batch_size": 2,
    "batch_max_failure_resolution_attempts": 2,
    "queue_conditions_required": [
     "base = main",
     "-draft",
     "label = review: approved",
     "check-success = ci",
     "label = records",
     "title ~= ^qa:",
     "files ~= qa/CAPABILITIES\\.md$"
    ],
    "merge_conditions_required": ["check-success = ci"],
    "merge_method": "merge"
   },
   "product": {
    "batch_size": 2,
    "batch_max_failure_resolution_attempts": 2,
    "queue_conditions_required": [
     "base = main",
     "-draft",
     "label = review: approved",
     "check-success = ci",
     "-label=records",
     "files ~= ^(?!(\\.github/|\\.githooks/|\\.mergify\\.yml$|\\.claude/|AGENTS\\.md$|CLAUDE\\.md$|ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/))",
     {
      "or": [
       "check-success = xfa-engine",
       "-files ~= ^(packages/xfa-engine/|tsconfig\\.base\\.json$|\\.nvmrc$|\\.github/workflows/xfa-engine\\.yml$)"
      ]
     },
     {"or": ["check-success = queue-fresh", "-files ~= /prototype/"]}
    ],
    "merge_conditions_required": ["check-success = ci"],
    "merge_method": "merge"
   },
   "pipeline": {
    "batch_size": 2,
    "batch_max_failure_resolution_attempts": 2,
    "queue_conditions_required": [
     "base = main",
     "-draft",
     "label = review: approved",
     "check-success = ci",
     "-label=records",
     "-files ~= ^(?!(\\.github/|\\.githooks/|\\.mergify\\.yml$|\\.claude/|AGENTS\\.md$|CLAUDE\\.md$|ai-workers/problem-1-pathway-setup-and-form-filling/product/tools/))",
     {
      "or": [
       "check-success = xfa-engine",
       "-files ~= ^(packages/xfa-engine/|tsconfig\\.base\\.json$|\\.nvmrc$|\\.github/workflows/xfa-engine\\.yml$)"
      ]
     }
    ],
    "merge_conditions_required": ["check-success = ci"],
    "merge_method": "merge"
   },
   "records": {
    "batch_size": 2,
    "batch_max_failure_resolution_attempts": 2,
    "queue_conditions_required": ["base = main", "-draft", "label = review: approved", "check-success = ci", "label = records"],
    "merge_conditions_required": ["check-success = ci"],
    "merge_method": "merge"
   }
  },
  "auto_merge_conditions": true
