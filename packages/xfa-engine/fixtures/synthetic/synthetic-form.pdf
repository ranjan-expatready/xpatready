Summary.Barcodes.presence = firstVar.value == "" ? "visible" : "hidden";
firstVar.value = "";</script></event></field>
<field name="AskBtn" w="80pt" h="20pt"><ui><button/></ui><caption placement="left" reserve="0pt"><value><text>Ask</text></value></caption><event activity="click"><script contentType="application/x-javascript">xfa.host.messageBox("Continue?", "Confirm", 2, 1);</script></event></field>
