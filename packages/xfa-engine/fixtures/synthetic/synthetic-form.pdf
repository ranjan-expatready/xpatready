<draw name="Blurb" w="300pt"><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p>This fictitious form has <span style="font-weight:bold">bold words</span>, some <span style="font-style:italic">italic ones</span> and enough text to wrap over more than one line in its box.</p></body></exData></value></draw>
<subform name="Panel" layout="position" w="300pt" h="110pt">
<draw name="Note" x="5pt" y="5pt" w="140pt" h="30pt"><value><text>A positioned note</text></value><border><edge thickness="0.5pt"/></border></draw>
