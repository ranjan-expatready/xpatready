<field name="Notes" w="260pt" h="50pt"><ui><textEdit multiLine="1"/></ui><caption placement="top" reserve="12pt"><value><text>Notes</text></value></caption><assist><toolTip>Free notes</toolTip></assist></field>
<field name="Age" w="260pt" h="18pt"><ui><numericEdit><border><edge thickness="0.5pt"/></border></numericEdit></ui><caption placement="left" reserve="90pt"><value><text>Age</text></value></caption><value><integer/></value></field>
