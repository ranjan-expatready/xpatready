<field name="Shade" w="260pt" h="18pt"><ui><choiceList><border><edge thickness="0.5pt"/></border></choiceList></ui><caption placement="left" reserve="90pt"><value><text>Shade</text></value></caption><items/><items presence="hidden" save="1"/><bindItems ref="xfa.datasets.LOV.Shade[*]" labelRef="$" valueRef="code"/></field>
<field name="When" w="260pt" h="18pt"><ui><dateTimeEdit><border><edge thickness="0.5pt"/></border></dateTimeEdit></ui><caption placement="left" reserve="90pt"><value><text>Date</text></value></caption><value><date/></value><format><picture>date{DD/MM/YYYY}</picture></format></field>
<field name="Agree" w="260pt" h="16pt"><ui><checkButton shape="square" mark="check"/></ui><caption placement="left" reserve="90pt"><value><text>Agree</text></value></caption><items><integer>1</integer><integer>0</integer></items><value><integer/></value></field>
