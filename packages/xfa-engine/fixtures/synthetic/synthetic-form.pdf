ext></value><border><edge thickness="0.5pt"/></border></draw><draw name="Pages" x="10pt" y="410pt" w="300pt" h="14pt"><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p>PAGE<span style="xfa-spacerun:yes"> </span><span xfa:embedType="uri" xfa:embedMode="raw" xfa:embed="#curB"></span> OF<span style="xfa-spacerun:yes"> </span><span xfa:embedType="uri" xfa:embedMode="raw" xfa:embed="#totB"></span></p></body></exData></value></draw></pageArea></pageSet><variables><text name="firstVar"/></variables><event activity="preSave"><script contentType="application/x-javascript">if (Summary.Flag.rawValue == "Yes") { Summary.Barcodes.bc1.rawValue = "SAMPLE|" + Details.Name.rawValue; }</script></event><subform name="Intro" layout="tb" w="300pt">
