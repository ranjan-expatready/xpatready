<subform name="Line1" layout="row"><draw name="c1" w="100pt" h="16pt"><value><text>First item</text></value><border><edge thickness="0.5pt"/></border></draw><field name="Count1" w="100pt" h="16pt"><ui><numericEdit><border><edge thickness="0.5pt"/></border></numericEdit></ui><value><integer/></value></field></subform>
</subform>
<field name="ValidateBtn" w="80pt" h="20pt"><ui><button highlight="outline"/></ui><caption placement="left" reserve="0pt"><value><text>Validate</text></value></caption><event activity="click"><script contentType="application/x-javascript">firstVar.value = "";
